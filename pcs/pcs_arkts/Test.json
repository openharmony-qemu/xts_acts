{
    "description": "Configuration for pcs arkts test",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "1800000",
        "bundle-name": "com.acts.pcs.arktstest",
        "module-name": "entry_test",
        "shell-timeout": "180000",
        "testcase-timeout": "600000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsPCSArkts.hap",
                "ActsPCSArktsTest.hap",
                "ActsPCSArktsAssist.hap",
                "./resource/pcs/bundle_sixth.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "push": [
                "./resource/pcs/bundle_fifth.hap -> /data/local/tmp/bundle_fifth.hap",
                "./resource/pcs/Believer.wav -> /data/local/tmp/Believer.wav",
				"./common_event.txt -> /data/local/tmp/common_event.txt",
                "./setup_pcs_arkts_test.sh -> /data/local/tmp/setup_pcs_arkts_test.sh"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_pcs_arkts_test.sh",
                "sh /data/local/tmp/setup_pcs_arkts_test.sh",
                "uitest dumpLayout"
            ]
        }
    ]
}
