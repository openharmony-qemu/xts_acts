import("//test/xts/tools/build/suite.gni")
import("//build/ohos_var.gni")

action("run_taihe") {
  script = rebase_path("my_script.sh")
  
  _output_dir = "$root_build_dir/taihe_output/ActsTaiheClassExtendsStaticTest"
  
  args = [
    rebase_path("${prebuilts_sdk_dir}/toolchains/taihe/bin/taihec"),
    rebase_path("entry/src/main/idl/foo.taihe"),
    "-O",
    rebase_path(_output_dir, root_build_dir),
    "-G",
    "cpp-author",
    "-G",
    "ani-bridge",
    "-Carkts:path-prefix=entry.src.main.src.ets"
  ]
  
  outputs = [
    "$root_build_dir/taihe_output/ActsTaiheClassExtendsStaticTest/foo.ets"
  ]
}

action("copy_taihe_output") {
  script = rebase_path("copy_output.sh")
  
  _src_dir = "$root_build_dir/taihe_output/ActsTaiheClassExtendsStaticTest"
  _stamp = "$target_gen_dir/copy_taihe.stamp"
  
  args = [
    rebase_path(_src_dir, root_build_dir),
    rebase_path("entry/src/main/src/ets", root_build_dir),
    rebase_path(_stamp, root_build_dir),
    rebase_path("entry/src/main/cpp", root_build_dir),
    rebase_path("entry/src/main/cpp/include", root_build_dir),
  ]
  
  outputs = [ _stamp ]
  deps = [ ":run_taihe" ]
}

ohos_js_app_static_suite("ActsTaiheClassExtendsStaticTest") {
  deps = [":copy_taihe_output"]
#   test_hap = true
  testonly = true
  certificate_profile = "./signature/myApplication_ohos_Provision.p7b"
  hap_name = "ActsTaiheClassExtendsStaticTest"
  part_name = "taihe_ffi_gen"
  subsystem_name = "arkcompiler"
}