{
  "description": "Config for actsmpeg2swdecodertest cases",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "1000000",
    "shell-timeout": "1000000",
    "bundle-name": "com.example.actsmpeg2swdecodertest",
    "module-name": "entry_test",
    "testcase-timeout": 1000000
  },
  "kits": [
    {
      "test-file-name": [
        "ActsMpeg2SwDecoderMainTest.hap",
        "ActsMpeg2SwDecoderHapTest.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "PushKit",
      "pre-push": [],
      "push": [
 	       "./resource/media/codec/video_decoder/main@high_level_1920_1080_60.m2v ->/data/local/tmp/",
         "./resource/media/codec/video_decoder/setup_mpeg2swdecoder_test.sh ->/data/local/tmp/"
      ]
    },
    {
      "type": "ShellKit",
      "run-command": [
      "power-shell wakeup",
      "power-shell setmode 602",
      "chmod 755  /data/local/tmp/setup_mpeg2swdecoder_test.sh",
      "sh /data/local/tmp/setup_mpeg2swdecoder_test.sh"
      ]
    }

  ]
}