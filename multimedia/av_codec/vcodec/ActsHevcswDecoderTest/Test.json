{
 "description": "Configuration for ActsHevcswDecoderTest Tests",
 "driver": {
   "type": "OHJSUnitTest",
   "test-timeout": "600000",
   "shell-timeout": "600000",
   "bundle-name": "com.example.actshevcswdecodertest",
   "module-name": "entry_test",
   "testcase-timeout": "60000"
 },
 "kits": [
   {
     "test-file-name": [
       "ActsHevcswDecoderHapTest.hap",
       "ActsHevcswDecoderMainTest.hap"
     ],
     "type": "AppInstallKit",
     "cleanup-apps": true
   },
   {
     "type": "PushKit",
     "pre-push": [],
     "push": [
       "./resource/media/codec/video_decoder/1920_1080_30.h265 ->/data/local/tmp/",
       "./resource/media/codec/video_decoder/hash_val.json ->/data/local/tmp/",
       "./resource/media/codec/video_decoder/setup_hevcswdecoder_test.sh ->/data/local/tmp/"
     ]
   },
   {
     "type": "ShellKit",
     "run-command": [
      "power-shell wakeup",
      "power-shell setmode 602",
      "chmod 755 /data/local/tmp/setup_hevcswdecoder_test.sh",
      "sh /data/local/tmp/setup_hevcswdecoder_test.sh"
     ]
   }
 ]
}
