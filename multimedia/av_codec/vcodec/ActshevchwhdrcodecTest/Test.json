{
  "description": "Configuration for ActshevchwhdrcodecTest Tests",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "600000",
    "shell-timeout": "600000",
    "bundle-name": "com.example.ActshevchwhdrcodecTest",
    "module-name": "entry_test",
    "testcase-timeout": "60000"
  },
  "kits": [
    {
      "test-file-name": [
        "ActshevchwhdrcodecTest.hap",
        "ActshevchwhdrcodecHapTest.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "PushKit",
      "pre-push": [],
      "push": [
        "./resource/media/codec/video_decoder/1920_1080_10_30Mb.h264 ->/data/local/tmp/",
        "./resource/media/codec/video_decoder/h263_aac.mp4 ->/data/local/tmp/",
        "./resource/media/codec/video_decoder/mpeg2.mp4 ->/data/local/tmp/",
        "./resource/media/codec/video_decoder/mpeg4_1280x720_30.mp4 ->/data/local/tmp/",
        "./resource/media/codec/video_decoder/h264_mp3_960x544_30r.mp4 ->/data/local/tmp/",
        "./resource/media/codec/video_decoder/VID_720.mp4 ->/data/local/tmp/",
        "./resource/media/codec/video_decoder/setup_hevchwhdrcodec_test.sh ->/data/local/tmp/"
      ]
    },
    {
      "type": "ShellKit",
      "run-command": [
      "power-shell wakeup",
      "power-shell setmode 602",
      "chmod 755 /data/local/tmp/setup_hevchwhdrcodec_test.sh",
      "sh /data/local/tmp/setup_hevchwhdrcodec_test.sh"
      ]
    }
  ]
}