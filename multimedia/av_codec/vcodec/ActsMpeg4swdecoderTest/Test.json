{
  "description": "Configuration for ActsMpeg4swdecoderTest Tests",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "600000",
    "shell-timeout": "600000",
    "bundle-name": "com.example.ActsMpeg4swdecoderTest",
    "module-name": "entry_test",
    "testcase-timeout": "60000"
  },
  "kits": [
    {
      "test-file-name": [
        "ActsMpeg4swdecoderTest.hap",
        "ActsMpeg4swdecoderHapTest.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/media/codec/video_decoder/mpeg4_main@level4_1920x1080_30.m4v ->/data/local/tmp/",
                "./resource/media/codec/video_decoder/setup_mpeg4swdecoder_test.sh ->/data/local/tmp/"
            ]
    },
    {
      "type": "ShellKit",
      "run-command": [
      "power-shell wakeup",
      "power-shell setmode 602",
      "chmod 755 /data/local/tmp/setup_mpeg4swdecoder_test.sh",
      "sh /data/local/tmp/setup_mpeg4swdecoder_test.sh"
      ]
    }
  ]
}
