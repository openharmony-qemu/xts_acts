{
  "description": "Config for actsswdecodertest cases",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "100000",
    "shell-timeout": "100000",
    "bundle-name": "com.example.actsswdecodertest",
    "module-name": "entry_test",
    "testcase-timeout": 100000
  },
  "kits": [
    {
      "test-file-name": [
        "ActsSwDecoderMainTest.hap",
        "ActsSwDecoderHapTest.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "PushKit",
      "pre-push": [],
      "push": [
        "./resource/media/codec/video_decoder/1920_1080_10_30Mb.h264 ->/data/local/tmp/",
        "./resource/media/codec/video_decoder/1280_720_30_10Mb.h264 ->/data/local/tmp/",
        "./resource/media/codec/video_decoder/resolutionChange.h264 ->/data/local/tmp/",
        "./resource/media/codec/video_decoder/hash_val.json ->/data/local/tmp/",
        "./resource/media/codec/video_decoder/setup_swdecoder_test.sh ->/data/local/tmp/"
      ]
    },
    {
      "type": "ShellKit",
      "run-command": [
                "power-shell wakeup",
                "power-shell setmode 602",
                "chmod 755 /data/local/tmp/setup_swdecoder_test.sh",
                "sh /data/local/tmp/setup_swdecoder_test.sh"
      ]
    }
  ]
}
