{
    "description": "Configuration for ActsHdrCodecHapTest Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "600000",
        "shell-timeout": "600000",
        "bundle-name": "com.example.ActsHdrCodecHapTest",
        "module-name": "entry_test",
        "testcase-timeout": "60000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsHdrCodecHapTest.hap",
                "ActsHdrCodecMainTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/media/codec/video_decoder/pq_vivid.h265 ->/data/local/tmp/",
                "./resource/media/codec/video_decoder/hlg_vivid_4k.h265 ->/data/local/tmp/",
                "./resource/media/codec/video_decoder/hlg_vivid_1080p.h265 ->/data/local/tmp/",
                "./resource/media/codec/video_decoder/setup_hdrcodec_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "power-shell wakeup",
                "power-shell setmode 602",
                "chmod 755 /data/local/tmp/setup_hdrcodec_test.sh",
                "sh /data/local/tmp/setup_hdrcodec_test.sh"
            ]
        }

    ]
}
