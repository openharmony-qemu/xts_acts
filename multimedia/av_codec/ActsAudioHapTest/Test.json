{
    "description": "Configuration for ActsAudioTestTest Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "600000",
        "shell-timeout": "600000",
        "bundle-name": "com.example.actsaudiotesttest",
        "module-name": "entry_test",
        "testcase-timeout": "60000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsAudioHapTest.hap",
                "ActsAudioHapMainTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/media/codec/audio_test/aac_2c_44100hz_199k.pcm ->/data/local/tmp/",
                "./resource/media/setup_avcodec_audio_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "power-shell wakeup",
                "power-shell setmode 602",
                "chmod 755 /data/local/tmp/setup_avcodec_audio_test.sh",
                "sh /data/local/tmp/setup_avcodec_audio_test.sh"
            ]
        }
    ]
}
