{
  "description": "Configuration for ActsImageFramework20Test Tests",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "180000",
    "bundle-name": "com.acts.imageframework20Test",
    "module-name": "entry_test",
    "shell-timeout": "600000",
    "testcase-timeout": 60000
  },
  "kits": [
    {
      "test-file-name": [
        "ActsImageFramework20MainTest.hap",
        "ActsImageFramework20Test.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "PushKit",
      "pre-push": [],
      "push": [
        "./resource/image/test_exif_v21.jpg ->/data/local/tmp/",
        "./resource/image/test51.jpg ->/data/local/tmp/",
        "./resource/image/test61.gif ->/data/local/tmp/",
        "./resource/image/sh/setup_image_Framework_20_test.sh ->/data/local/tmp/"
    ]
    },
    {
      "type": "ShellKit",
      "run-command": [
        "power-shell wakeup",
        "power-shell setmode 602",
        "power-shell timeout -o 86400000",
        "hidumper -s 3301 -a -t",
        "chmod 755 /data/local/tmp/setup_image_Framework_20_test.sh",
        "sh /data/local/tmp/setup_image_Framework_20_test.sh"
      ]
    }
  ]
}
