{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "600000",
        "bundle-name": "ohos.acts.multimedia.image.sendableImageSource",
        "module-name": "entry_test",
        "shell-timeout": "300000",
        "testcase-timeout": "180000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsSendableImageSourceTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/test.bmp ->/data/local/tmp/",
                "./resource/image/test.dng ->/data/local/tmp/",
                "./resource/image/test.gif ->/data/local/tmp/",
                "./resource/image/test.ico ->/data/local/tmp/",
                "./resource/image/test.png ->/data/local/tmp/",
                "./resource/image/test.webp ->/data/local/tmp/",
                "./resource/image/SVG.svg ->/data/local/tmp/",
                "./resource/image/dog.astc ->/data/local/tmp/",
                "./resource/image/sh/setup_image_sendableImageSource_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "param set persist.ace.testmode.enabled 1",
                "power-shell wakeup",
                "power-shell timeout -o 2147483647",
                "uinput -T -m 300 2700 280 200",
                "power-shell setmode 602",
                "chmod 755 /data/local/tmp/setup_image_sendableImageSource_test.sh",
                "sh /data/local/tmp/setup_image_sendableImageSource_test.sh"
            ]
        }
    ]
}