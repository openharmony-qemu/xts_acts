{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.image",
        "module-name": "entry_test",
        "shell-timeout": "300000",
        "testcase-timeout": "180000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/CUVAHdr.jpg ->/data/local/tmp/",
                "./resource/image/JPEGVividSingle.jpg ->/data/local/tmp/",
                "./resource/image/mimeType_test.jpg ->/data/local/tmp/",
                "./resource/image/mimeType_test.ico ->/data/local/tmp/",
                "./resource/image/mimeType_test.dng ->/data/local/tmp/",
                "./resource/image/mimeType_test.cr2 ->/data/local/tmp/",
                "./resource/image/mimeType_test.raf ->/data/local/tmp/",
                "./resource/image/mimeType_test.nrw ->/data/local/tmp/",
                "./resource/image/mimeType_test.rw2 ->/data/local/tmp/",
                "./resource/image/mimeType_test.pef ->/data/local/tmp/",
                "./resource/image/mimeType_test.arw ->/data/local/tmp/",
                "./resource/image/mimeType_test.nef ->/data/local/tmp/",
                "./resource/image/mimeType_test.orf ->/data/local/tmp/",
                "./resource/image/mimeType_test.srw ->/data/local/tmp/",
                "./resource/image/mimeType_test.cur ->/data/local/tmp/",
                "./resource/image/mimeType_test.jfif ->/data/local/tmp/",
                "./resource/image/flower.webp ->/data/local/tmp/",
                "./resource/image/normal1.jpg ->/data/local/tmp/",
                "./resource/image/normal2.jpg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_image_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_image_test.sh",
                "sh /data/local/tmp/setup_image_image_test.sh"
            ]
        }
    ]
}