{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.imagePicturePack",
        "module-name": "entry_test",
        "shell-timeout": "300000",
        "testcase-timeout": "30000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImagePicturePackTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/HEIFISOMultiChannelBaseColor0512V12.heic ->/data/local/tmp/",
                "./resource/image/0801_sdr2.heic ->/data/local/tmp/",
                "./resource/image/all_auxtype.heic ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/AllAuxiliaryPictures.jpg ->/data/local/tmp/",
                "./resource/image/JPEGISOSingle.jpg ->/data/local/tmp/",
                "./resource/image/AllAuxiliaryPictures_exclude_fragment.jpg ->/data/local/tmp/",
                "./resource/image/JpegFragmentMap.jpg ->/data/local/tmp/",
                "./resource/image/testExif.jpg ->/data/local/tmp/",
                "./resource/image/GainMap.dat ->/data/local/tmp/",
                "./resource/image/UnrefocusMap.dat ->/data/local/tmp/",
                "./resource/image/FragmentMap.dat ->/data/local/tmp/",
                "./resource/image/jpeg_exif_thumbnail.jpg ->/data/local/tmp/",
                "./resource/image/jpeg_no_thumbnail.jpg ->/data/local/tmp/",
                "./resource/image/heif_box_thumbnail.heic ->/data/local/tmp/",
                "./resource/image/heif_exif_thumbnail.heic ->/data/local/tmp/",
                "./resource/image/heif_no_thumbnail.heic ->/data/local/tmp/",
                "./resource/image/300_100.jpg ->/data/local/tmp/",
                "./resource/image/generateThumbnailFailed.jpg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_picturePack_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "power-shell wakeup",
                "power-shell timeout -o 2147483647",
                "power-shell setmode 602",
                "chmod 755 /data/local/tmp/setup_image_picturePack_test.sh",
                "sh /data/local/tmp/setup_image_picturePack_test.sh"
            ]
        }
    ]
}