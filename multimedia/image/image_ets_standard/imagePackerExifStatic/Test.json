{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.imagePackerExif.Static",
        "module-name": "entry",
        "shell-timeout": "300000",
        "testcase-timeout": "180000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImagePackerExifStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test_exif_v2.jpg ->/data/local/tmp/",
                "./resource/image/test_exif_v2.png ->/data/local/tmp/",
                "./resource/image/test_exif_v2.webp ->/data/local/tmp/",
                "./resource/image/test_exif_empty.jpg ->/data/local/tmp/",
                "./resource/image/test_exif_empty.png ->/data/local/tmp/",
                "./resource/image/test_exif_empty.webp ->/data/local/tmp/",
                "./resource/image/test_exif_v3.jpg ->/data/local/tmp/",
                "./resource/image/test_exif_v3.png ->/data/local/tmp/",
                "./resource/image/test_exif_v3.webp ->/data/local/tmp/",
                "./setup_image_packerExif_static_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_packerExif_static_test.sh",
                "sh /data/local/tmp/setup_image_packerExif_static_test.sh"
            ]
        }
    ]
}