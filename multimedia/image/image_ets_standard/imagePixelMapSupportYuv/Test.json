{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.imagepixelMapSupportYuv",
        "module-name": "entry_test",
        "shell-timeout": "300000",
        "testcase-timeout": "180000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsimagepixelMapSupportYuvTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/yuv_test_ete.jpg ->/data/local/tmp/",
                "./resource/image/yuv_test_ote.jpg ->/data/local/tmp/",
                "./resource/image/yuv_test_eto.jpg ->/data/local/tmp/",
                "./resource/image/yuv_test_oto.jpeg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_pixelMapSupportYuv_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_pixelMapSupportYuv_test.sh",
                "sh /data/local/tmp/setup_image_pixelMapSupportYuv_test.sh"
            ]
        }
    ]
}