{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "600000",
        "testcase-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.imageGetMimeType",
        "shell-timeout": "600000",
        "module-name": "entry_test"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageGetMimeTypeTestMain.hap",
                "ActsImageGetMimeTypeTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test.wbmp ->/data/local/tmp/",
                "./resource/image/test.bmp ->/data/local/tmp/",
                "./resource/image/test.gif ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/test.webp ->/data/local/tmp/",
                "./resource/image/test.ico ->/data/local/tmp/",
                "./resource/image/test.svg ->/data/local/tmp/",
                "./resource/image/test.dng ->/data/local/tmp/",
                "./resource/image/test.png ->/data/local/tmp/",
                "./resource/image/test.jpeg ->/data/local/tmp/",
                "./resource/image/mimeType_test.cr2 ->/data/local/tmp/",
                "./resource/image/mimeType_test.raf ->/data/local/tmp/",
                "./resource/image/mimeType_test.nef ->/data/local/tmp/",
                "./resource/image/mimeType_test.nrw ->/data/local/tmp/",
                "./resource/image/mimeType_test.orf ->/data/local/tmp/",
                "./resource/image/mimeType_test.rw2 ->/data/local/tmp/",
                "./resource/image/mimeType_test.pef ->/data/local/tmp/",
                "./resource/image/mimeType_test.srw ->/data/local/tmp/",
                "./resource/image/mimeType_test.arw ->/data/local/tmp/",
                "./resource/image/HDRVividSingleLayer.heic ->/data/local/tmp/",
                "./resource/image/moving_test.webp ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_png.gif ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_jpeg.png ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_jpg.jpeg ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_bmp.dng ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_gif.tiff ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_webp.ico ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_ico.svg ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_dng.jpg ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_heic.png ->/data/local/tmp/",
                "./resource/image/sh/setup_image_getMimeType_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_getMimeType_test.sh",
                "sh /data/local/tmp/setup_image_getMimeType_test.sh"
            ],
            "teardown-command": []
        }
    ]
}