{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.imagePixelmap.Static",
        "module-name": "entry",
        "shell-timeout": "300000",
        "testcase-timeout": "10000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImagePixelMapStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/test.png ->/data/local/tmp/",
                "./resource/image/test.bmp ->/data/local/tmp/",
                "./resource/image/test.gif ->/data/local/tmp/",
                "./resource/image/test.webp ->/data/local/tmp/",
                "./resource/image/test_dng.dng ->/data/local/tmp/",
                "./resource/image/0801_sdr2.heic ->/data/local/tmp/",
                "./resource/image/test.ico ->/data/local/tmp/",
                "./resource/image/SIZE_0_0.jpg ->/data/local/tmp/",
                "./resource/image/CUVAHdrMulti.jpg ->/data/local/tmp/",
                "./resource/image/test_DMA.jpg ->/data/local/tmp/",
                "./resource/image/test_DMA_33_77.jpg ->/data/local/tmp/",
                "./resource/image/test_DMA_55_77.jpg ->/data/local/tmp/",
                "./resource/image/test_DMA_128_256.jpg ->/data/local/tmp/",
                "./resource/image/test_DMA_512_512.jpg ->/data/local/tmp/",
                "./resource/image/test_DMA_2999_3742.jpg ->/data/local/tmp/",
                "./resource/image/test_DMA_3071_4095.jpg ->/data/local/tmp/",
                "./resource/image/test_DMA_3072_4096.jpg ->/data/local/tmp/",
                "./resource/image/test_DMA_1801_4041.jpg ->/data/local/tmp/",
                "./resource/image/jpeg_exif_thumbnail.jpg ->/data/local/tmp/",
                "./resource/image/jpeg_no_thumbnail.jpg ->/data/local/tmp/",
                "./resource/image/heif_exif_thumbnail.heic ->/data/local/tmp/",
                "./resource/image/heif_box_thumbnail.heic ->/data/local/tmp/",
                "./resource/image/heif_no_thumbnail.heic ->/data/local/tmp/",
                "./resource/image/300_100.jpg ->/data/local/tmp/",
                "./resource/image/generateThumbnailFailed.jpg ->/data/local/tmp/",
                "./resource/image/empty_image.jpg ->/data/local/tmp/",
                "./resource/image/jpeg_exif_thumbnail_too_large.jpg ->/data/local/tmp/",
                "./setup_image_imagePixelmap_static_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_imagePixelmap_static_test.sh",
                "sh /data/local/tmp/setup_image_imagePixelmap_static_test.sh",
                "power-shell wakeup",
                "power-shell setmode 602"
            ]
        }
    ]
}