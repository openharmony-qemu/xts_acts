{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.imagePicture",
        "module-name": "entry_test",
        "shell-timeout": "300000",
        "testcase-timeout": "50000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImagePictureTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/HEIFISOMultiChannelBaseColor0512V12.heic ->/data/local/tmp/",
                "./resource/image/0801_sdr2.heic ->/data/local/tmp/",
                "./resource/image/all_auxtype.heic ->/data/local/tmp/",
                "./resource/image/AllAuxiliaryPictures.jpg ->/data/local/tmp/",
                "./resource/image/CUVAHdrMulti.jpg ->/data/local/tmp/",
                "./resource/image/HDRVividSingleLayer.heic ->/data/local/tmp/",
                "./resource/image/JPEGISOSingle.jpg ->/data/local/tmp/",
                "./resource/image/AllAuxiliaryPictures_exclude_fragment.jpg ->/data/local/tmp/",
                "./resource/image/JpegFragmentMap.jpg ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/test.png ->/data/local/tmp/",
                "./resource/image/testExif.jpg ->/data/local/tmp/",
                "./resource/image/GainMap.dat ->/data/local/tmp/",
                "./resource/image/UnrefocusMap.dat ->/data/local/tmp/",
                "./resource/image/FragmentMap.dat ->/data/local/tmp/",
                "./resource/image/dog.astc ->/data/local/tmp/",
                "./resource/image/test_code116.jpg ->/data/local/tmp/",
                "./resource/image/test5.jpg ->/data/local/tmp/",
                "./resource/image/IMG_825866834_004.heic ->/data/local/tmp/",
                "./resource/image/LHDR.jpg ->/data/local/tmp/",
                "./resource/image/LHDR.heic ->/data/local/tmp/",
                "./resource/image/test_aisr.dng ->/data/local/tmp/",
                "./resource/image/3072_4096.jpg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_picture_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "power-shell wakeup",
                "power-shell timeout -o 2147483647",
                "power-shell setmode 602",
                "chmod 755 /data/local/tmp/setup_image_picture_test.sh",
                "sh /data/local/tmp/setup_image_picture_test.sh"
            ]
        }
    ]
}