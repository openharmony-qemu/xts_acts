{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.imageFormatTranscoding",
        "module-name": "entry_test",
        "shell-timeout": "300000",
        "testcase-timeout": "180000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageFormatTranscodingTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/JPG_800500.jpg ->/data/local/tmp/",
                "./resource/image/JPG_800501.jpg ->/data/local/tmp/",
                "./resource/image/JPG_801500.jpg ->/data/local/tmp/",
                "./resource/image/JPG_801501.jpg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_formatTranscoding_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_formatTranscoding_test.sh",
                "sh /data/local/tmp/setup_image_formatTranscoding_test.sh"
            ]
        }
    ]
}