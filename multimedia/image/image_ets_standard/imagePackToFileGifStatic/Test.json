{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.imagePackToFileGif.Static",
        "module-name": "entry",
        "shell-timeout": "300000",
        "testcase-timeout": "100000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImagePackToFileGifStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test.png ->/data/local/tmp/",
                "./resource/image/moving_test.gif ->/data/local/tmp/",
                "./resource/image/test.bmp ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/test.ico ->/data/local/tmp/",
                "./resource/image/test.svg ->/data/local/tmp/",
                "./resource/image/test.dng ->/data/local/tmp/",
                "./resource/image/test.jpeg ->/data/local/tmp/",
                "./resource/image/test.webp ->/data/local/tmp/",
                "./resource/image/HDRVividSingleLayer.heic ->/data/local/tmp/",
                "./resource/image/sh/setup_image_packToFileGif_static_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_packToFileGif_static_test.sh",
                "sh /data/local/tmp/setup_image_packToFileGif_static_test.sh",
                "power-shell wakeup",
                "power-shell setmode 602"
            ]
        }
    ]
}