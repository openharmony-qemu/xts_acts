{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.imageXMPMetadata",
        "module-name": "entry_test",
        "shell-timeout": "300000",
        "testcase-timeout": "180000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageXMPMetadataTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/jpeg_xmp.jpg ->/data/local/tmp/",
                "./resource/image/png_xmp.png ->/data/local/tmp/",
                "./resource/image/3gif_xmp.gif ->/data/local/tmp/",
                "./resource/image/dng_xmp.dng ->/data/local/tmp/",
                "./resource/image/tiff_xmp.tiff ->/data/local/tmp/",
                "./resource/image/test_exif_v2.jpg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_xmpMetadata_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_xmpMetadata_test.sh",
                "sh /data/local/tmp/setup_image_xmpMetadata_test.sh"
            ]
        }
    ]
}