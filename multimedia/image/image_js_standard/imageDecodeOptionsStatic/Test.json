{
    "description": "Configuration for Image Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "1200000",
        "shell-timeout": "1200000",
        "bundle-name": "ohos.acts.multimedia.image.DecodeOptions.Static",
        "testcase-timeout": 60000,
        "module-name": "entry"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageDecodeOptionsJsStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test.bmp ->/data/local/tmp/",
                "./resource/image/test.png ->/data/local/tmp/",
                "./resource/image/test.tiff ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/moving_test.gif ->/data/local/tmp/",
                "./resource/image/sh/setup_image_decodeOptionsJs_static_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_decodeOptionsJs_static_test.sh",
                "sh /data/local/tmp/setup_image_decodeOptionsJs_static_test.sh"
            ],
            "teardown-command": []
        }
    ]
}