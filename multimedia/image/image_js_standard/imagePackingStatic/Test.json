{
    "description": "Configuration for Image Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "1500000",
        "shell-timeout": "1500000",
        "bundle-name": "ohos.acts.multimedia.image.Packing.Static",
        "testcase-timeout": 180000,
        "module-name": "entry"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImagePackingJsStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test.png ->/data/local/tmp/",
                "./resource/image/moving_test.gif ->/data/local/tmp/",
                "./resource/image/test.bmp ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/test.ico ->/data/local/tmp/",
                "./resource/image/test.svg ->/data/local/tmp/",
                "./resource/image/test.dng ->/data/local/tmp/",
                "./resource/image/test.jpeg ->/data/local/tmp/",
                "./resource/image/test.webp ->/data/local/tmp/",
                "./resource/image/HDRVividSingleLayer.heic ->/data/local/tmp/",
                "./setup_image_packingJs_static_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_packingJs_static_test.sh",
                "sh /data/local/tmp/setup_image_packingJs_static_test.sh"
            ]
        }
    ]
}