{
    "description": "Configuration for Image Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "shell-timeout": "120000",
        "bundle-name": "ohos.acts.multimedia.image.Static",
        "module-name": "entry"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageGetImagePropertyJsStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test_exif1.jpg ->/data/local/tmp/",
                "./resource/image/snow.jpg ->/data/local/tmp/",
                "./resource/image/greenplant.jpg ->/data/local/tmp/",
                "./resource/image/flower.jpg ->/data/local/tmp/",
                "./resource/image/text.jpg ->/data/local/tmp/",
                "./resource/image/food.jpg ->/data/local/tmp/",
                "./resource/image/bluesky.jpg ->/data/local/tmp/",
                "./resource/image/sunset.jpg ->/data/local/tmp/",
                "./resource/image/night.jpg ->/data/local/tmp/",
                "./resource/image/test_hw.jpg ->/data/local/tmp/",
                "./resource/image/test_exif.jpg ->/data/local/tmp/",
                "./resource/image/test_exif.png ->/data/local/tmp/",
                "./resource/image/test.tiff ->/data/local/tmp/",
                "./resource/image/moving_test_loop5.gif ->/data/local/tmp/",
                "./resource/image/moving_test_loop1.gif ->/data/local/tmp/",
                "./resource/image/moving_test_loop0.gif ->/data/local/tmp/",
                "./setup_image_getImagePropertyJs_static_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_getImagePropertyJs_static_test.sh",
                "sh /data/local/tmp/setup_image_getImagePropertyJs_static_test.sh"
            ],
            "teardown-command": [
                "rm -rf /data/app/el2/100/base/ohos.acts.multimedia.image.Static/*"
            ]
        }
    ]
}