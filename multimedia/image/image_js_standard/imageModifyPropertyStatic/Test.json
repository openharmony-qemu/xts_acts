{
    "description": "Configuration for Image Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "shell-timeout": "120000",
        "bundle-name": "ohos.acts.multimedia.image.ModifyProperty.Static",
        "module-name": "entry"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageModifyPropertyJsStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test_exif.jpg ->/data/local/tmp/",
                "./resource/image/test.tiff ->/data/local/tmp/",
                "./resource/image/moving_test_loop1.gif ->/data/local/tmp/",
                "./resource/image/modifyBuffer.jpg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_modifyPropertyJs_static_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_modifyPropertyJs_static_test.sh",
                "sh /data/local/tmp/setup_image_modifyPropertyJs_static_test.sh"
            ],
            "teardown-command": [
                "rm -rf /data/app/el2/100/base/ohos.acts.multimedia.image.ModifyProperty.Static/haps/entry/files/*"
            ]
        }
    ]
}