{
    "description": "Configuration for Image Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "shell-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.Static",
        "testcase-timeout": "180000",
        "module-name": "entry"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageJsStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test.bmp ->/data/local/tmp/",
                "./resource/image/test.png ->/data/local/tmp/",
                "./resource/image/test.123 ->/data/local/tmp/",
                "./resource/image/test.gif ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/moving_test.gif ->/data/local/tmp/",
                "./resource/image/test.ico ->/data/local/tmp/",
                "./resource/image/test.svg ->/data/local/tmp/",
                "./resource/image/test.dng ->/data/local/tmp/",
                "./resource/image/test.jpeg ->/data/local/tmp/",
                "./resource/image/moving_test.webp ->/data/local/tmp/",
                "./resource/image/test_large.webp ->/data/local/tmp/",
                "./resource/image/test_large.svg ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_jpg.jpeg ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_jpeg.png ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_png.gif ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_gif.tiff ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_webp.ico ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_ico.svg ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_svg.bmp ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_bmp.dng ->/data/local/tmp/",
                "./resource/wrongSuffixImage/wrong_suffix_dng.jpg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_image_static_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_image_static_test.sh",
                "sh /data/local/tmp/setup_image_image_static_test.sh"
            ],
            "teardown-command": []
        }
    ]
}