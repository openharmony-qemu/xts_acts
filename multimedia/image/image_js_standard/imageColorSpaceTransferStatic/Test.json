{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "600000",
        "testcase-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.colorSpaceTransfer.Static",
        "shell-timeout": "600000",
        "module-name": "entry"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageColorSpaceTransferStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "push": [
                "./resource/image/colorspace.jpg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_colorSpaceTransfer_static_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_colorSpaceTransfer_static_test.sh",
                "sh /data/local/tmp/setup_image_colorSpaceTransfer_static_test.sh"
            ],
            "teardown-command": []
        }
    ]
}