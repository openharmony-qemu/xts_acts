{
    "description": "Configuration for Image Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "shell-timeout": "120000",
        "bundle-name": "ohos.acts.multimedia.image.ModifyProperty",
        "module-name": "entry_test"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageModifyPropertyJsTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test_exif_empty.heic ->/data/local/tmp/",
                "./resource/image/test_exif_empty.jpg ->/data/local/tmp/",
                "./resource/image/test_exif_empty.png ->/data/local/tmp/",
                "./resource/image/test_exif_empty.webp ->/data/local/tmp/",
                "./resource/image/test_exif_v2.jpg ->/data/local/tmp/",
                "./resource/image/test_exif.jpg ->/data/local/tmp/",
                "./resource/image/test.tiff ->/data/local/tmp/",
                "./resource/image/moving_test_loop1.gif ->/data/local/tmp/",
                "./resource/image/test_exif_v3.heic ->/data/local/tmp/",
                "./resource/image/test_exif.png ->/data/local/tmp/",
                "./resource/image/test_exif_v2.webp ->/data/local/tmp/",
                "./resource/image/test_dng.dng ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/testExif.jpg ->/data/local/tmp/",
                "./resource/image/food.jpg ->/data/local/tmp/",
                "./resource/image/food_notHW.jpg ->/data/local/tmp/",
                "./resource/image/food_notHW2.jpg ->/data/local/tmp/",
                "./resource/image/test.bmp ->/data/local/tmp/",
                "./resource/image/moving_test.gif ->/data/local/tmp/",
                "./resource/image/test.ico ->/data/local/tmp/",
                "./resource/image/test_large.svg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_modifyPropertyJs_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_modifyPropertyJs_test.sh",
                "sh /data/local/tmp/setup_image_modifyPropertyJs_test.sh"
            ],
            "teardown-command": [
                "rm -rf /data/app/el2/100/base/ohos.acts.multimedia.image.ModifyProperty/haps/entry_test/files/*"
            ]
        }
    ]
}