{
    "description": "Configuration for Image Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "shell-timeout": "120000",
        "bundle-name": "ohos.acts.multimedia.image",
        "module-name": "entry_test"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageSvgJsTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test_large.svg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_svgJs_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_svgJs_test.sh",
                "sh /data/local/tmp/setup_image_svgJs_test.sh"
            ]
        }
    ]
}