{
    "description": "Configuration for Image Exif Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "shell-timeout": "300000",
        "bundle-name": "ohos.acts.multimedia.image.Exif",
        "testcase-timeout": 60000,
        "module-name": "entry_test"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageExifJsTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test_exif.jpg ->/data/local/tmp/",
                "./resource/image/test_exif1.jpg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_exif_js_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_exif_js_test.sh",
                "sh /data/local/tmp/setup_image_exif_js_test.sh"
            ]
        }
    ]
}