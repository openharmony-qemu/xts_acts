{
    "description": "Configuration for Image Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "shell-timeout": "120000",
        "bundle-name": "ohos.acts.multimedia.image.Raw.Static",
        "module-name": "entry",
        "testcase-timeout": "180000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageRawJsStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/test.nrw ->/data/local/tmp/",
                "./resource/image/test.cr2 ->/data/local/tmp/",
                "./resource/image/test_dng.dng ->/data/local/tmp/",
                "./resource/image/test.cr3 ->/data/local/tmp/",
                "./resource/image/test.arw ->/data/local/tmp/",
                "./resource/image/test.pef ->/data/local/tmp/",
                "./resource/image/test.raf ->/data/local/tmp/",
                "./resource/image/test.rw2 ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./setup_image_rawJs_static_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_rawJs_static_test.sh",
                "sh /data/local/tmp/setup_image_rawJs_static_test.sh"
            ],
            "teardown-command": [
                "rm -rf /data/app/el2/100/base/ohos.acts.multimedia.image.Raw.Static/*"
            ]
        }
    ]
}