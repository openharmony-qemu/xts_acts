{
    "description": "Configuration for Image Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "100000",
        "shell-timeout": "120000",
        "bundle-name": "ohos.acts.multimedia.image.Webp",
        "testcase-timeout": 60000,
        "module-name": "entry_test"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageWebpJsTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "push": [
                "./resource/image/test_large.webp ->/data/local/tmp/",
                "./resource/image/moving_test.webp ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/sh/setup_image_webpJs_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_webpJs_test.sh",
                "sh /data/local/tmp/setup_image_webpJs_test.sh"
            ],
            "teardown-command": []
        }
    ]
}