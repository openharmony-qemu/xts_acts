{
    "description": "Configuration for Image Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "shell-timeout": "120000",
        "bundle-name": "ohos.acts.multimedia.image",
        "module-name": "entry_test",
        "testcase-timeout": "180000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsImageGifJsTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/image/moving_test.gif ->/data/local/tmp/",
                "./resource/image/test.gif ->/data/local/tmp/",
                "./resource/image/test.jpg ->/data/local/tmp/",
                "./resource/image/incomplete_test.gif ->/data/local/tmp/",
                "./resource/image/fake_large_size_test.gif ->/data/local/tmp/",
                "./resource/image/0801_sdr2.heic ->/data/local/tmp/",
                "./resource/image/test.bmp ->/data/local/tmp/",
                "./resource/image/test_dng.dng ->/data/local/tmp/",
                "./resource/image/test.png ->/data/local/tmp/",
                "./resource/image/heif.heic ->/data/local/tmp/",
                "./resource/image/sh/setup_image_gifJs_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_image_gifJs_test.sh",
                "sh /data/local/tmp/setup_image_gifJs_test.sh"
            ],
            "teardown-command": [
                "rm -rf /data/app/el2/100/base/ohos.acts.multimedia.image/*"
            ]
        }
    ]
}