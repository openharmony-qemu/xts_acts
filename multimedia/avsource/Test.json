{
    "description": "Configuration for ActsAVCodecTest Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "600000",
        "shell-timeout": "600000",
        "bundle-name": "com.multimedia.napitest",
        "module-name": "entry_test"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsAVCodecTest.hap",
                "ActsAVCodecMainTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/media/demo.mp4 ->/data/local/tmp/",
                "./resource/media/demo1.mp4 ->/data/local/tmp/",
                "./resource/media/codec/audio_decoder/aac_2c_44100hz_199k_lc.dat ->/data/local/tmp/",
                "./resource/media/setup_avsource_test.sh ->/data/local/tmp/"
            ]
        },
		{
            "type": "ShellKit",
            "run-command": [
                "power-shell wakeup",
                "power-shell setmode 602",
                "chmod 755 /data/local/tmp/setup_avsource_test.sh",
                "sh /data/local/tmp/setup_avsource_test.sh"
            ]
        }
    ]
}
