{
    "description": "Configuration for videoplayer Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "2000000",
        "shell-timeout": "2000000",
        "testcase-timeout": 60000,
        "bundle-name": "ohos.acts.multimedia.video.videoplayer",
        "module-name": "entry_test"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsVideoPlayerJsTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/audio/H264_AAC.mp4 ->/data/local/tmp/",
                "./resource/audio/01.mp3 ->/data/local/tmp/",
                "./resource/media/setup_media_js_standard_videoPlayer_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "power-shell setmode 602",
                "chmod 755 /data/local/tmp/",
                "sh /data/local/tmp/setup_media_js_standard_videoPlayer_test.sh"
            ],
            "teardown-command": [
                "power-shell setmode 600"
            ]
        }
    ]
}