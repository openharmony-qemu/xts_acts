{
    "description": "Configuration for AVDownloader Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "180000",
        "bundle-name": "ohos.acts.multimedia.avdownloader",
        "module-name": "entry_test",
        "shell-timeout": "9000000",
        "testcase-timeout": 180000
    },
    "kits": [
        {
            "test-file-name": [
                "ActsAVDownloaderTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "ShellKit",
            "run-command": [
                "remount",
                "mkdir /data/test",
                "mkdir -p /data/app/el2/100/base/ohos.acts.multimedia.avdownloader/haps/entry_test/files",
                "chmod 777 -R /data/app/el2/100/base/ohos.acts.multimedia.avdownloader/haps/entry_test"
            ]
        },
        {
            "type": "PushKit",
            "push": [
                "ActsAVDownloaderTest.hap->/data/test/ActsAVDownloaderTest.hap"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 644 /data/test/*.hap",
                "scanner",
                "param set persist.ace.testmode.enabled 1"
            ]
        }
    ]
}
