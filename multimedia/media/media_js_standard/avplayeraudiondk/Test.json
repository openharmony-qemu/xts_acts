{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "360000",
        "bundle-name": "com.example.avplayeraudiondk",
        "module-name": "entry_test",
        "shell-timeout": "360000",
        "testcase-timeout": 70000
    },
    "kits": [{
        "test-file-name": [
            "ActsAVPlayerAudioNDKTest.hap",
			"ActsAVPlayerAudioNDKMainTest.hap"
        ],
        "type": "AppInstallKit",
        "cleanup-apps": true
    },
    {
        "type": "PushKit",
        "push": [
            "./resource/audio/01.mp3 -> /data/local/tmp/",
            "./resource/media/setup_media_js_standard_avplayeraudio_test.sh -> /data/local/tmp/"
        ]
    },
    {
        "type": "ShellKit",
        "run-command": [
            "scanner",
            "param set persist.ace.testmode.enabled 1",
            "chmod 755 /data/local/tmp/",
            "sh /data/local/tmp/setup_media_js_standard_avplayeraudio_test.sh"
        ]
    }]
}