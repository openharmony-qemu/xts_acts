{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "360000",
        "bundle-name": "com.example.avplayeraudiondk",
        "module-name": "entry_test",
        "shell-timeout": "360000",
        "testcase-timeout": 70000
    },
    "kits": [{
        "test-file-name": [
            "ActsAVPlayerAudioNDKTest.hap",
			"ActsAVPlayerAudioNDKMainTest.hap"
        ],
        "type": "AppInstallKit",
        "cleanup-apps": true
    },
    {
        "type": "ShellKit",
        "run-command": [
            "remount",
            "mkdir /data/app/el2/100/base/com.example.avplayeraudiondk/files",
            "chmod 777 -R /data/app/el2/100/base/com.example.avplayeraudiondk/files"
        ]
    },
    {
        "type": "PushKit",
        "push": [
            "./resource/audio/01.mp3 -> /data/app/el2/100/base/com.example.avplayeraudiondk/files/"
        ]
    },
    {
        "type": "ShellKit",
        "run-command": [
            "scanner",
            "param set persist.ace.testmode.enabled 1"
        ]
    }]
}