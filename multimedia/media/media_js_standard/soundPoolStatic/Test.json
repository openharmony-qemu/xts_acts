{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "180000",
        "bundle-name": "com.example.soundpoolxts.static",
        "module-name": "entry",
        "shell-timeout": "600000",
        "testcase-timeout": "180000"
    },
    "kits": [{
        "test-file-name": [
            "ActsSoundPoolStaticTest.hap"
        ],
        "type": "AppInstallKit",
        "cleanup-apps": true
    },
    {
        "type": "ShellKit",
        "run-command": [
            "remount",
            "mkdir /data/test"
        ]
    },
    {
        "type": "PushKit",
        "push": [
            "./resource/soundpool/test_01.mp3 -> /data/local/tmp/",
            "./resource/soundpool/test_02.mp3 -> /data/local/tmp/",
            "./resource/soundpool/test_03.mp3 -> /data/local/tmp/",
            "./resource/soundpool/test_04.mp3 -> /data/local/tmp/",
            "./resource/soundpool/test_05.wav -> /data/local/tmp/",
            "./resource/media/setup_media_js_standard_soundPoolStatic_test.sh ->/data/local/tmp/" 
        ]
    },
    {
        "type": "ShellKit",
        "run-command": [
            "power-shell wakeup",
            "uinput -T -m 300 2700 280 200",
            "power-shell setmode 602",
            "chmod 755 /data/local/tmp/",
            "sh /data/local/tmp/setup_media_js_standard_soundPoolStatic_test.sh"
        ]
    }]
}
