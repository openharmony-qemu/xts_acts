{
  "description": "Configuration for avplayer Tests",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "600000",
    "shell-timeout": "600000",
    "bundle-name": "com.avplayer.napi20test",
    "module-name": "com.avplayer.napi20test",
    "testcase-timeout": 30000
  },
  "kits": [
    {
      "test-file-name": [
        "ActsAVPlayerNdk20Test.hap",
        "ActsAVPlayerMain20Test.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "PushKit",
      "push": [
        "./resource/media/AAC_48000_32_1.aac -> /data/local/tmp/",
        "./resource/media/H264_AAC.mp4 -> /data/local/tmp/",
        "./resource/media/AVPlayer/H264_AAC.mkv -> /data/local/tmp/",
        "./resource/media/setup_media_js_standard_avPlayerNdk20_test.sh -> /data/local/tmp/"
      ]
    },
    {
      "type": "ShellKit",
      "run-command": [
        "power-shell wakeup",
        "power-shell timeout -o 2147483647",
        "power-shell setmode 602",
        "chmod 755 /data/local/tmp/",
        "sh /data/local/tmp/setup_media_js_standard_avPlayerNdk20_test.sh"
      ]
    }
  ]
}
