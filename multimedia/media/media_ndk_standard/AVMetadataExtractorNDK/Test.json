{
    "description": "Configuration for OhAudioNdk Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "600000",
        "bundle-name": "com.example.avmetadataextractorndk",
        "module-name": "entry_test",
        "shell-timeout": "600000",
        "testcase-timeout": 30000
    },
    "kits": [
        {
            "test-file-name": [
                "ActsOhAVMetadataExtractorNDKMainTest.hap",
                "ActsOhAVMetadataExtractorNDKTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "ShellKit",
            "run-command": [
                "mkdir -p /data/app/el2/100/base/com.example.avmetadataextractorndk/haps/entry_test/files/",
                "chmod -R 666 /data/app/el2/100/base/com.example.avmetadataextractorndk/haps/entry_test/files/*",
                "mkdir -p /data/app/el2/100/base/com.example.avmetadataextractorndk/haps/entry_test/cache/",
                "chmod -R 777 /data/app/el2/100/base/com.example.avmetadataextractorndk/haps/entry_test/*"
            ]
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/media/MP4_ROTATE_90.mp4 ->/data/local/tmp/",
                "./resource/media/metadata/H264_AAC.mp4 ->/data/local/tmp/",
                "./resource/media/codec/demuxer/Muxer_Auxiliary_01.mp4 ->/data/local/tmp/",
                "./resource/media/setup_media_ndk_standard_avmetadataextractor_test.sh -> /data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod -R 777 /data/local/tmp//*",
                "power-shell wakeup",
                "power-shell timeout -o 2147483647",
                "power-shell setmode 602",
                "chmod 755 /data/local/tmp/",
                "sh /data/local/tmp/setup_media_ndk_standard_avmetadataextractor_test.sh"
            ]
        }
    ]
}
