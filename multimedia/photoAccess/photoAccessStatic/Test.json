{
    "description": "Configuration for photoAccess Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "180000",
        "bundle-name": "ohos.acts.multimedia.photoaccess.Static",
        "module-name": "entry",
        "shell-timeout": "600000",
        "testcase-timeout": "1200000"
    },
    "kits": [
        {
            "type": "ShellKit",
            "pre-push": [],
            "run-command": [
                "rm -rf /storage/media/100/local/files/Pictures",
                "rm -rf /storage/media/100/local/files/Videos",
                "rm -rf /storage/media/100/local/files/Camera",
                "rm -rf /storage/media/100/local/files/Audios",
                "rm -rf /storage/media/100/local/files/Docs/Documents/*",
                "rm -rf /storage/media/100/local/files/Docs/Documents/.*",
                "rm -rf /storage/media/100/local/files/entry/*",
                "sleep 5",
                "rm -rf /data/app/el2/100/database/com.ohos.medialibrary.medialibrarydata/*",
                "kill -9 `pidof com.ohos.medialibrary.medialibrarydata`"
            ]
        },
        {
            "test-file-name": [
                "ActsPhotoAccessNDKStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "PushKit",
            "pre-push": [],
            "push": [
                "./resource/medialibrary/01.gif ->/data/local/tmp/",
                "./resource/medialibrary/01.jpg ->/data/local/tmp/",
                "./resource/medialibrary/01.mp4 ->/data/local/tmp/",
                "./resource/medialibrary/01.mpeg ->/data/local/tmp/",
                "./resource/medialibrary/01.png ->/data/local/tmp/",
                "./resource/medialibrary/error_jpg.jpg ->/data/local/tmp/",
                "./resource/medialibrary/error_mp4.mp4 ->/data/local/tmp/",
                "./resource/medialibrary/test_hdr_1.mp4 ->/data/local/tmp/",
                "./resource/medialibrary/test_mov_1.jpg ->/data/local/tmp/",
                "./resource/medialibrary/test_mov_1.mp4 ->/data/local/tmp/",
                "./resource/medialibrary/sh/setup_photoAccessStatic_test.sh ->/data/local/tmp/"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "chmod 755 /data/local/tmp/setup_photoAccessStatic_test.sh",
                "sh /data/local/tmp/setup_photoAccessStatic_test.sh"
            ]
        },
        {
            "type": "ShellKit",
            "pre-push": [],
            "run-command": [
                "param set persist.ace.testmode.enabled 1",
                "power-shell wakeup",
                "power-shell timeout -o 2147483647",
                "uinput -T -m 300 2700 280 200",
                "power-shell setmode 602",
                "mkdir -p /storage/media/100/local/files/Pictures",
                "mkdir -p /storage/media/100/local/files/Videos",
                "mkdir -p /storage/media/100/local/files/Camera",
                "mkdir -p /storage/media/100/local/files/Audios",
                "mkdir /storage/media/100/local/files/Pictures/Screenshots",
                "chmod -R 777 /storage/media/100/local/files/*",
                "chmod -R 777 /data/service/el2/100/hmdfs/account/files/*"
            ]
        },
        {
            "type": "ShellKit",
            "run-command": [
                "hilog -Q pidoff",
                "hilog -Q domainoff",
                "hilog -b D -D 0xD002B70"
            ],
            "teardown-command": [
                "power-shell setmode 600",
                "hilog -Q pidon",
                "hilog -Q domainon",
                "rm -rf /storage/media/100/local/files/Pictures",
                "rm -rf /storage/media/100/local/files/Videos",
                "rm -rf /storage/media/100/local/files/Camera",
                "rm -rf /storage/media/100/local/files/Audios",
                "rm -rf /storage/media/100/local/files/Docs/Documents/*",
                "rm -rf /storage/media/100/local/files/Docs/Documents/.*",
                "rm -rf /storage/media/100/local/files/entry/*",
                "sleep 5",
                "rm -rf /data/app/el2/100/database/com.ohos.medialibrary.medialibrarydata/*",
                "kill -9 `pidof com.ohos.medialibrary.medialibrarydata`"
            ]
        }
    ]
}