{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "ValidatorTest",
        "bundle-name": "com.example.iotcvalidator",
        "package-name": "com.example.iotcvalidator",
        "xml_path": "/data/app/el2/100/base/com.example.iotcvalidator/haps/entry/files/IOT/IOTConfigTest.xml"
    },
    "kits": [
        {
            "type": "PushKit",
            "pre-push": [
                "mount -o rw,remount /",
                "power-shell wakeup",
                "uinput -T -m 300 1279 280 200",
                "uinput -T -d 300 600 -u 300 100",
                "power-shell timeout -o 86400000",
                "printf '%s' '{\"bundleName\":\"com.ohos.iotmanagementsvc\",\"app_signature\":[\"5E047E55280883CB26E80BCDECBB84D83E14F01D16A6DEF1D83D242CFAB4299B\"],\"allowAppDesktopIconHide\":true,\"allowAppUsePrivilegeExtension\":true}' > /data/local/tmp/cap_node.json",
                "printf '%s' '{\"bundleName\":\"com.ohos.iotmanagementsvc\",\"app_signature\":[\"5E047E55280883CB26E80BCDECBB84D83E14F01D16A6DEF1D83D242CFAB4299B\"],\"permissions\":[{\"name\":\"ohos.permission.START_ABILITIES_FROM_BACKGROUND\",\"userCancellable\":false},{\"name\":\"ohos.permission.GET_BUNDLE_INFO\",\"userCancellable\":false},{\"name\":\"ohos.permission.USE_BLUETOOTH\",\"userCancellable\":false},{\"name\":\"ohos.permission.ACCESS_BLUETOOTH\",\"userCancellable\":false},{\"name\":\"ohos.permission.DISCOVER_BLUETOOTH\",\"userCancellable\":false},{\"name\":\"ohos.permission.MANAGE_BLUETOOTH\",\"userCancellable\":false},' > /data/local/tmp/perm_node.json",
                "printf '%s' '{\"name\":\"ohos.permission.GET_NETWORK_INFO\",\"userCancellable\":false},{\"name\":\"ohos.permission.MANAGE_WIFI_CONNECTION\",\"userCancellable\":false},{\"name\":\"ohos.permission.GET_WIFI_PEERS_MAC\",\"userCancellable\":false},{\"name\":\"ohos.permission.GET_WIFI_CONFIG\",\"userCancellable\":false},{\"name\":\"ohos.permission.SET_WIFI_CONFIG\",\"userCancellable\":false},{\"name\":\"ohos.permission.SET_WIFI_INFO\",\"userCancellable\":false},' >> /data/local/tmp/perm_node.json",
                "printf '%s' '{\"name\":\"ohos.permission.GET_WIFI_INFO\",\"userCancellable\":false},{\"name\":\"ohos.permission.INTERNET\",\"userCancellable\":false},{\"name\":\"ohos.permission.GET_DISTRIBUTED_ACCOUNT\",\"userCancellable\":false},{\"name\":\"ohos.permission.ACCESS_SERVICE_DM\",\"userCancellable\":false},{\"name\":\"ohos.permission.GET_BLUETOOTH_PEERS_MAC\",\"userCancellable\":false}]}' >> /data/local/tmp/perm_node.json",
                "tac /system/etc/app/install_list_capability.json | tail -n +2 | tac > /data/local/tmp/_cap.tmp && mv /data/local/tmp/_cap.tmp /system/etc/app/install_list_capability.json",
                "tac /system/etc/app/install_list_capability.json | tail -n +2 | tac > /data/local/tmp/_cap.tmp && mv /data/local/tmp/_cap.tmp /system/etc/app/install_list_capability.json",
                "tac /system/etc/app/install_list_capability.json | sed '1s/}/},/' | tac > /data/local/tmp/_cap.tmp && mv /data/local/tmp/_cap.tmp /system/etc/app/install_list_capability.json",
                "cat /data/local/tmp/cap_node.json >> /system/etc/app/install_list_capability.json",
                "echo '    ]' >> /system/etc/app/install_list_capability.json",
                "echo '}' >> /system/etc/app/install_list_capability.json",
                "tac /system/etc/app/install_list_permissions.json | tail -n +2 | tac > /data/local/tmp/_perm.tmp && mv /data/local/tmp/_perm.tmp /system/etc/app/install_list_permissions.json",
                "tac /system/etc/app/install_list_permissions.json | sed '1s/}/},/' | tac > /data/local/tmp/_perm.tmp && mv /data/local/tmp/_perm.tmp /system/etc/app/install_list_permissions.json",
                "cat /data/local/tmp/perm_node.json >> /system/etc/app/install_list_permissions.json",
                "echo ']' >> /system/etc/app/install_list_permissions.json"
            ],
            "push": [],
            "post-push": [
                "mount -o rw,remount /",
                "reboot"
            ],
            "uninstall": false
        },
        {
            "test-file-name": [
                "./resource/xts-validator/iotc/iotmanagementsvc.hap",
                "iotc_validator.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": false
        },
        {
            "type": "ShellKit",
            "run-command": [
                "hilog -Q pidoff",
                "power -shell wakeup",
                "uinput -T -m 300 1279 280 200",
                "uinput -T -d 300 600 -u 300 100",
                "power-shell timeout -o 86400000"
            ]
        },
        {
            "type": "CommandKit",
            "shell": [
                {
                    "name": "shell",
                    "value": "aa start -a MainAbility -b com.example.iotcvalidator"
                }
            ]
        },
        {
            "type": "PushKit",
            "push": [],
            "uninstall": false
        }
    ]
}