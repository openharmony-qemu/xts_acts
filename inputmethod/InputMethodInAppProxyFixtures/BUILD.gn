import("//test/xts/tools/build/suite.gni")

ohos_xts_executable("ActsInputMethodInAppProxyCapacityWorker") {
  testonly = true
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  # RegisterOptions is a Parcelable value type whose vtable is hidden by
  # inputmethod_ability.versionscript. Compile its production serializer;
  # the actual IMF implementation remains the shared inner kit below.
  sources = [
    "//base/inputmethod/imf/frameworks/native/inputmethod_controller/src/input_method_utils.cpp",
    "native/real_process_worker.cpp",
  ]
  install_enable = false
  subsystem_name = "inputmethod"
  part_name = "imf"

  # WindowAdapter/WindowStub expose actual WMS focus without a renderer in
  # every retained registration process. They do not implement IMF callbacks.
  include_dirs = [
    "//foundation/window/window_manager",
    "//foundation/window/window_manager/wm/include",
    "//foundation/window/window_manager/wm/include/zidl",
  ]
  deps = [
    "//foundation/window/window_manager/utils:libwmutil",
    "//foundation/window/window_manager/utils:libwmutil_base",
  ]
  external_deps = [
    "ability_base:configuration",
    "ability_runtime:ability_context_native",
    "ability_runtime:ability_manager",
    "bounds_checking_function:libsec_shared",
    "bundle_framework:appexecfwk_base",
    "c_utils:utils",
    "graphic_2d:librender_service_base",
    "graphic_2d:librender_service_client",
    "graphic_2d:window_animation",
    "hilog:libhilog",
    "imf:inputmethod_ability",
    "imf:inputmethod_client",
    "input:libmmi-client",
    "ipc:ipc_single",
    "libuv:uv",
    "napi:ace_napi",
    "resource_management:global_resmgr",
    "samgr:samgr_proxy",
    "window_manager:libwm",
  ]
}

# Depend on this copy target from the HAP suite. PushKit consumes the file
# beside the HAP; the helper is never installed in a production system image.
_worker_output = "$root_out_dir/ActsInputMethodInAppProxyCapacityWorker"
if (is_standard_system) {
  _worker_output = "$root_out_dir/inputmethod/imf/ActsInputMethodInAppProxyCapacityWorker"
}

copy("capacity_worker_resource") {
  testonly = true
  deps = [ ":ActsInputMethodInAppProxyCapacityWorker" ]
  sources = [ _worker_output ]
  outputs = [ "$SUITE_OUT_DIR/testcases/{{source_file_part}}" ]
}

copy("capacity_script_resource") {
  testonly = true
  sources = [ "capacity.sh" ]
  outputs = [ "$SUITE_OUT_DIR/testcases/ActsInputMethodInAppProxyCapacity.sh" ]
}

group("capacity_resources") {
  testonly = true
  deps = [
    ":capacity_script_resource",
    ":capacity_worker_resource",
  ]
}
