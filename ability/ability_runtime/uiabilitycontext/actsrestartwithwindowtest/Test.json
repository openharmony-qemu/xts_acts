{
    "description": "Configuration for hjunit Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "600000",
        "bundle-name": "com.acts.ability.restartapp",
        "module-name": "entry",
        "shell-timeout": "30000",
        "testcase-timeout": 60000
    },
    "kits": [
        {
            "test-file-name": [
                "ActsRestartWithWindowRely.hap",
                "ActsRestartWithWindowTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "ShellKit",
            "run-command": [
                "param set persist.sys.abilityms.support.ecologicalrulemgrservice false"
            ],
            "teardown-command": [
                "param set persist.sys.abilityms.support.ecologicalrulemgrservice true"
          ]
        }
    ]
}