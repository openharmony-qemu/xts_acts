{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "300000",
        "bundle-name": "com.acts.actsinterfacemultiusersthirdtest",
        "module-name": "phone",
        "shell-timeout": "300000",
        "testcase-timeout": "30000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsAmsUsersThirdTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },{
          "type": "ShellKit",
          "run-command": [
              "power-shell wakeup",
              "power-shell setmode 602",
              "power-shell timeout -o 86400000",
              "uinput -T -m 300 1279 280 200"
          ]
        }
    ]
}