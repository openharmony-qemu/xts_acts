{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
      "type": "OHJSUnitTest",
      "test-timeout": "600000",
      "bundle-name": "com.example.abilitymonitortest",
      "module-name": "entry_test",
      "shell-timeout": "600000",
      "testcase-timeout": "30000"
    },
    "kits": [
        {
            "test-file-name": [
                "ActsAbilityMonitorTest.hap",
                "ActsAbilityMonitorMain.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "ShellKit",
            "run-command": [
                "power-shell wakeup",
                "power-shell setmode 602",
                "uinput -T -m 300 1279 280 200",
                "uinput -T -d 1070 1070 -u 1070 1070",
                "power-shell timeout -o 864000000"
            ]
        }
    ]
}