{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "180000",
        "bundle-name": "com.example.lifecycletest",
        "module-name": "entry_test",
        "shell-timeout": "600000",
        "testcase-timeout": 70000
    },
    "kits": [
        {
            "test-file-name": [
                "ActsLifecycleMultiHapTest.hap",
                "ActsLifecycleMultiHap2.hap",
                "ActsLifecycleMultiHap3.hap",
                "ActsLifecycleMultiHapMain.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },{
            "type": "ShellKit",
            "run-command": [
                "power-shell wakeup",
                "power-shell setmode 602",
                "power-shell timeout -o 864000000",
                "uinput -T -m 300 1279 280 200"
            ]
        }
    ] 
}
