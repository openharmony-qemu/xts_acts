{
    "description": "Configuration for setAbilityInstanceInfo nopermission static tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "180000",
        "shell-timeout": "600000",
        "bundle-name": "com.acts.setabilityinstanceinfonopermission.static",
        "module-name": "entry",
        "testcase-timeout": 60000
    },
    "kits": [
        {
            "test-file-name": [
                "ActsSetAbilityInstanceInfoNoPermissionStaticTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "ShellKit",
            "run-command": [
                "power-shell wakeup",
                "uinput -T -m 300 1279 280 200",
                "uinput -T -d 300 600 -u 300 100",
                "power-shell timeout -o 86400000",
                "power-shell setmode 602"
            ]
        }
    ]
}
