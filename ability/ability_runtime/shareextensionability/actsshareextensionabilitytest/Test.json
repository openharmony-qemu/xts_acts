{
    "description": "Configuration for aceceshi Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "600000",
        "bundle-name": "com.example.actsshareextensionabilitytest",
        "module-name": "entry_test",
        "shell-timeout": "600000",
        "testcase-timeout": 25000
    },
    "kits": [
		{
            "test-file-name": [
                "ActsShareExtensionAbilityOtherRely.hap",
                "ActsShareExtensionAbilitySelfRely.hap",
                "ActsShareExtensionAbilitySelfModule.hap",
                "ActsShareExtensionAbilityTest.hap"
            ],
            "type": "AppInstallKit",
            "cleanup-apps": true
        },
        {
            "type": "ShellKit",
            "run-command": [
                "power-shell wakeup",
                "power-shell setmode 602",
                "uinput -T -d 300 600 -m 300 600 300 100 -u 300 100",
                "uinput -T -m 300 1279 280 200",
                "uinput -T -d 1070 1070 -u 1070 1070",
                "power-shell timeout -o 864000000"
            ]
        }
    ]
}