function bubbleSort(arr: Array<number>): Array<number> {
  let n: number = arr.length;
  for (let i: number = 0; i < n - 1; i++) {
    for (let j: number = 0; j < n - 1 - i; j++) {
      if (arr[j] > arr[j + 1]) {
        let temp: number = arr[j];
        arr[j] = arr[j + 1];
        arr[j + 1] = temp;
      }
    }
  }
  return arr;
}

export { bubbleSort };