{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "180000",
        "shell-timeout": "600000",
        "bundle-name": "com.edm.acts.network",
        "module-name": "entry_test",
        "testcase-timeout": "20000"
    },
    "kits": [
        {
            "type": "ShellKit",
            "run-command": [
            ]
        },
        {
            "type": "PushKit",
            "push":[
            ]
