{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "180000",
        "bundle-name": "com.openharmony.certificate_manager_func.static",
        "module-name": "entry",
        "shell-timeout": "600000",
        "testcase-timeout": "300000"
    },
    "kits": [{
        "test-file-name": [
            "ActsCertificateManagerJsFuncStaticTest.hap"
        ],
        "type": "AppInstallKit",
        "cleanup-apps": true
    },{
        "type": "ShellKit",
        "run-command": [
          "power-shell wakeup",
          "uinput -T -m 300 2700 280 200",
          "uinput -K -d 2050 -u 2050",
          "wait 5",
          "uinput -T -m 300 2700 280 200",
          "hidumper -s 3301 -a -t"
        ]
    }]
}