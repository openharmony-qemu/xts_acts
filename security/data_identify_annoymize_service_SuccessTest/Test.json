{
  "description": "Configuration for hjunit demo Tests",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "1200000",
    "bundle-name": "com.openharmony.data_identify_annoymize_service_js",
    "module-name": "phone",
    "shell-timeout": "1200000",
    "testcase-timeout": "6000"
  },
  "kits": [
    {
      "test-file-name": [
        "ActsDataIdentifyTest.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "ShellKit",
      "run-command": [
        "hdc shell \"echo 'my name hello aaa' > /data/app/el2/0/database/h.txt\""
      ],
      "teardown-command": [
        "power-shell setmode 601"
      ]
    }
  ]
}