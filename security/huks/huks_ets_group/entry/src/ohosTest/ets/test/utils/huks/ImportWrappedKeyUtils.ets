export async function BuildSm2WrappedKeyData(deviceAPubKeyData: Uint8Array, plainKeyData: Uint8Array) {
  let kekSize = 128;
  let kekAlias = "kekAlias";
  let genKekOptions = GetSm4GenerateOptions(kekSize);
  let kekData = GetAsymKeyData(kekSize);
  SetInData(genKekOptions, kekData)
  await huks.importKeyItem(kekAlias, genKekOptions);
  let plainKeyEncryptOptions = MergeOptions(GetSm4GenerateOptions(kekSize), GetEcbNoPaddingOptions())
  let plainKeyEncryptData: CipherData = {
    updateDataArr: null,
    finishData: plainKeyData
  }
  let plainKeyEncryptedData = (await DoCipher(kekAlias, plainKeyEncryptOptions, plainKeyEncryptData)).finishData as Uint8Array;
  let plainKeyEncryptedDataLen = IntToUint8Array(plainKeyEncryptedData.length);

  let pubKeySize = 256;
  let pubKeyAlias = "pubKeyAlias";
  let importPubKeyOptions = MergeOptions(GetSm2GenerateOptions(pubKeySize), GetImportPubKeyOptions());
  SetParam(importPubKeyOptions, huks.HuksTag.HUKS_TAG_PURPOSE, huks.HuksKeyPurpose.HUKS_KEY_PURPOSE_ENCRYPT);
  SetInData(importPubKeyOptions, deviceAPubKeyData);
  await huks.importKeyItem(pubKeyAlias, importPubKeyOptions);
  let kekEncryptOptions = MergeOptions(GetSm2GenerateOptions(pubKeySize), GetSm3NoPaddingOptions());
  let kekEncryptData: CipherData = {
    updateDataArr: null,
    finishData: kekData
  }
  let kekEncryptedData = (await DoCipher(pubKeyAlias, kekEncryptOptions, kekEncryptData)).finishData as Uint8Array;
  let kekEncryptedDataLen = IntToUint8Array(kekEncryptedData.length);
  return new Uint8Array([...kekEncryptedDataLen, ...kekEncryptedData, ...plainKeyEncryptedDataLen, ...plainKeyEncryptedData])
}