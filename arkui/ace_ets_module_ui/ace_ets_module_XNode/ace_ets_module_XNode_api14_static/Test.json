{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "10800000",
        "bundle-name": "com.arkui.ace.XNode.api14.static",
        "module-name": "entry",
        "shell-timeout": "10800000",
        "testcase-timeout": 300000
    },
    "kits": [{
        "test-file-name": ["ActsAceEtsModuleXNodeApi14StaticTest.hap"],
        "type": "AppInstallKit",
        "cleanup-apps": true
    },{
        "type": "ShellKit",
        "run-command": [
            "power-shell wakeup",
            "power-shell setmode 602"
        ]
    }]
}