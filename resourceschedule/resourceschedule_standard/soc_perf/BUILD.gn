import("//test/xts/tools/build/suite.gni")
 
module_output_path = "acts/ActsSOCPERFAPITest"
 
SOCPERF_PATH = "//foundation/resourceschedule/soc_perf/"
 
config("socperfapitest_config") {
  visibility = [ ":*" ]
  include_dirs = [ "$SOCPERF_PATH/services/core/include" ]
}
 
ohos_moduletest_suite("ActsSOCPERFAPITest") {
  module_out_path = module_output_path
  sources = [ "src/SocperfApiTest.cpp" ]

  deps = [
    "//third_party/googletest:gmock",
    "//third_party/googletest:gtest",
  ]
 
  external_deps = [
    "resource_schedule_service:resschedsvc"
  ]
 
  configs = [ ":socperfapitest_config" ]
 
  subsystem_name = "resourceschedule"
  part_name = "soc_perf"
}