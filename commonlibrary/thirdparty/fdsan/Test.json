{
    "description": "Configuration for ActsThirdPartyFdsan Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "600000",
        "shell-timeout": "600000",
        "bundle-name": "com.thirdparty.fdsan.napitest",
        "module-name": "entry_test"
    },
    "kits": [{
        "test-file-name": [
            "ActsThirdPartyFdsanMainTest.hap",
            "ActsThirdPartyFdsanTest.hap"
        ],
        "type": "AppInstallKit",
        "cleanup-apps": true
    }, {
        "type": "ShellKit",
        "run-command": [
            "power-shell wakeup",
            "power-shell setmode 602"
        ]

    }]
}