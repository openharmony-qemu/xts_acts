import { ArkTSUtils } from '@kit.ArkTS';

@Concurrent
export async function constructorNamedNestedInnerFunc(counter: ConstructorNamedNestedCounter): Promise<number> {
  let observed: number = 0
  await counter.lock.lockAsync<number>((): number => {
    counter.count++
    observed = counter.count
    return observed
  })
  return observed
}


@Sendable
export class ConstructorNamedNestedCounter {
  count: number = 0
  lock: ArkTSUtils.locks.AsyncLock = new ArkTSUtils.locks.AsyncLock()
}
