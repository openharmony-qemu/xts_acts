function test_div_001(dividend: string, divisor: string, expected: string, sd: number, rm: number) {
  Decimal.set({ precision: sd, rounding: rm });
  expect(expected).assertEqual(Decimal.div(dividend, divisor).valueOf());
  expect(expected).assertEqual(new Decimal(dividend).div(divisor).valueOf());
}

function test_div_002(dividend: string, divisor: number, expected: string, sd: number, rm: number) {
  Decimal.set({ precision: sd, rounding: rm });
  expect(expected).assertEqual(Decimal.div(dividend, divisor).valueOf());
  expect(expected).assertEqual(new Decimal(dividend).div(divisor).valueOf());
}

function test_sqrt_001(expected: string, n: string, sd: number, rm: number) {
  Decimal.set({ precision: sd, rounding: rm });
  expect(expected).assertEqual(Decimal.sqrt(n).valueOf());
  expect(expected).assertEqual(new Decimal(n).sqrt().valueOf());
}

function test_sqrt_002(expected: string, n: number, sd: number, rm: number) {
  Decimal.set({ precision: sd, rounding: rm });
  expect(expected).assertEqual(Decimal.sqrt(n).valueOf());
  expect(expected).assertEqual(new Decimal(n).sqrt().valueOf());
}


