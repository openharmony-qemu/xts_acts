class CustomPromiseWrapper<T> {
  private _promise: Promise<T>;

  constructor(executor: (resolve: (value: T) => void, reject: (reason?: Error) => void) => void) {
    this._promise = new Promise<T>(executor);
  }

  getPromise(): Promise<T> {
    return this._promise;
  }

  static customResolve<T>(value: T): CustomPromiseWrapper<T> {
    return new CustomPromiseWrapper<T>((resolve: (val: T) => void): void => {
      resolve(value);
    });
  }

  static customReject<T>(reason: Error): CustomPromiseWrapper<T> {
    return new CustomPromiseWrapper<T>((resolve: (val: T) => void, reject: (err: Error) => void): void => {
      reject(reason);
    });
  }

  then(onFulfilled?: (value: T) => T | Promise<T>, onRejected?: (reason: Error) => T | Promise<T>): Promise<T> {
    return this._promise.then(onFulfilled, onRejected);
  }

  catch(onRejected: (reason: Error) => T | Promise<T>): Promise<T> {
    return this._promise.catch(onRejected);
  }

  finally(onFinally?: () => void): Promise<T> {
    return this._promise.finally(onFinally);
  }
}

class ExtendedPromiseWrapper<T> extends CustomPromiseWrapper<T> {
  constructor(executor: (resolve: (value: T) => void, reject: (reason?: Error) => void) => void) {
    super(executor);
  }
}


export default function isPromiseTest() {
  describe('IsPromiseTest', () => {
    beforeAll(() => {
      console.info('beforeAll called');
    });

    beforeEach(async () => {
      await sleep(SLEEP_INTERVAL_MS);
    });

    afterEach(() => {
      console.info('afterEach called');
    });

    afterAll(() => {
      console.info('afterAll called');
    });

    it('testIsPromiseStaticAsyncMethod', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL0, async (done: Function): Promise<void> => {
      const caseName = 'testIsPromiseStaticAsyncMethod';
      console.info(`${caseName} test start`);

      const promise: Promise<string> = TestStaticAsyncMethod.staticAsyncMethod();
      const type: util.types = new util.types();
      const result: boolean = type.isPromise(promise);
      expect(result).assertTrue();

      console.info(`${caseName} test end`);
      done();
    });

    it('testIsPromiseStaticAsyncAfterGetSet', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL0, async (done: Function): Promise<void> => {
      const caseName = 'testIsPromiseStaticAsyncAfterGetSet';
      console.info(`${caseName} test start`);

      const promise: Promise<string> = TestStaticAsyncWithGetSet.staticAsyncAfterGetSet();
      const type: util.types = new util.types();
      const result: boolean = type.isPromise(promise);
      expect(result).assertTrue();

      console.info(`${caseName} test end`);
      done();
    });

    it('testIsPromiseInheritedAsync', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL0, async (done: Function): Promise<void> => {
      const caseName = 'testIsPromiseInheritedAsync';
      console.info(`${caseName} test start`);

      const instance: TestDerivedClass = new TestDerivedClass();
      const promise: Promise<string> = instance.baseMethod();
      const type: util.types = new util.types();
      const result: boolean = type.isPromise(promise);
      expect(result).assertTrue();

      console.info(`${caseName} test end`);
      done();
    });

    it('testIsPromiseOverriddenAsync', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL0, async (done: Function): Promise<void> => {
      const caseName = 'testIsPromiseOverriddenAsync';
      console.info(`${caseName} test start`);

      const instance: TestOverrideClass = new TestOverrideClass();
      const promise: Promise<string> = instance.baseMethod();
      const type: util.types = new util.types();
      const result: boolean = type.isPromise(promise);
      expect(result).assertTrue();

      console.info(`${caseName} test end`);
      done();
    });

    it('testIsPromiseArrowFunction', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL0, async (done: Function): Promise<void> => {
      const caseName = 'testIsPromiseArrowFunction';
      console.info(`${caseName} test start`);

      const promise: Promise<string> = arrowAsyncFunc();
      const type: util.types = new util.types();
      const result: boolean = type.isPromise(promise);
      expect(result).assertTrue();

      console.info(`${caseName} test end`);
      done();
    });

    it('testIsPromiseAssignedAsync', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL0, async (done: Function): Promise<void> => {
      const caseName = 'testIsPromiseAssignedAsync';
      console.info(`${caseName} test start`);

      const promise: Promise<number> = assignedAsyncFunc();
      const type: util.types = new util.types();
      const result: boolean = type.isPromise(promise);
      expect(result).assertTrue();

      console.info(`${caseName} test end`);
      done();
    });

    it('testIsPromiseAsParameter', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL0, async (done: Function): Promise<void> => {
      const caseName = 'testIsPromiseAsParameter';
      console.info(`${caseName} test start`);

      const promise: Promise<string> = callAsyncFunc(asyncFunction);
      const type: util.types = new util.types();
