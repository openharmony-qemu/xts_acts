<div class="container">
    <div class="content-title">
        <text class="title-text">swiper</text>
        <input type="button" value="?" class="backBtnHelp" onclick="help" />
    </div>

    <swiper
            index="{{index}}"
            duration="200"
            class="swiper-area"
            vertical="true"
            onchange="showPage"
            >
        <stack class="swiper-stack">
            <text class="swiper-text">第{{index}}页，共2页</text>
            <text class="swiper-text-2">attr010</text>
        </stack>
        <stack class="swiper-stack">
            <text class="swiper-text">第{{index}}页，共2页</text>
        </stack>
        <stack class="swiper-stack">
            <text class="swiper-text">第{{index}}页，共2页</text>
        </stack>
    </swiper>

    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="changeResultPass" />
        <input type="button" value="fail" class="button" onclick="changeResultFail" />
        <input type="button" value="返回" class="button" onclick="back" />
    </div>
</div>
