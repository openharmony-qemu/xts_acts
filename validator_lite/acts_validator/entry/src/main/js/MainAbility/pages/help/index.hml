<div class="container">
  <div class="help-header">
    <text class="help-title">操作说明</text>
    <input type="button" value="返回" class="backBtnTop" onclick="back" />
  </div>
  <text class="help-text">{{step}}</text>
  <text class="help-text">{{result}}</text>
  <text class="help-text">通过点 pass，失败点 fail。</text>
</div>
