<div class="container">
    <div class="content-title">
        <text style="width:180px;height:50px;text-align:center;font-size:16px;">flex aspect-ratio</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>

    <div class="content">
        <text class="desc">Tap ratio buttons. The blue box keeps width 80px and changes height.</text>
        <div class="stage">
            <div class="reference-box">
                <text class="box-text">80x80</text>
            </div>
            <div class="test-box" style="aspect-ratio: {{aspectRatio}};">
                <text class="box-text">{{aspectLabel}}</text>
            </div>
        </div>
        <text class="expect">{{expectText}}</text>
        <div class="ratio-row">
            <input type="button" value="1:1" class="ratio-btn" onclick="setAspectOne" />
            <input type="button" value="2:1" class="ratio-btn" onclick="setAspectTwo" />
            <input type="button" value="1:2" class="ratio-btn" onclick="setAspectHalf" />
        </div>
    </div>

    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
