<div class="container">
    <div class="content-title">
        <text style="width:150px;height:50px;text-align:center;font-size:16px;">image</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>
    <div class="content">
        <image style="width:120px;height:120px;margin:10px;" src="/common/icon.png"></image>
        <text style="font-size:14px;color:#888888;margin:10px;">Image should display above</text>
    </div>
    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
