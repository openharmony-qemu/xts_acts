<div class="container">
  <div class="content-title">
    <text style="width:130px;height:50px;text-align: center;font-size:14px;">image-animator</text>
    <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
  </div>
  <text style="width: 80%;height: 48px;text-align: center;">{{state}}</text>
  <image-animator
    ref="animator"
    class="image-animator"
    images="{{frames}}"
    duration="1s"
    style="height: 176px; width: 176px;"
    onstop="logStop"
  ></image-animator>
  <div class="content-bt">
    <input class="button-bt" type="button" value="播放" onclick="handleStart" />
    <input class="button-bt" type="button" value="暂停" onclick="handlePause" />
    <input class="button-bt" type="button" value="恢复" onclick="handleResume" />
    <input class="button-bt" type="button" value="停止" onclick="handleStop" />
  </div>

  <div class="bottom-bt">
    <input type="button" value="pass" class="button" onclick="passClicked" />
    <input type="button" value="fail" class="button" onclick="failClicked" />
    <input type="button" value="back" class="button" onclick="backClicked" />
  </div>
</div>
