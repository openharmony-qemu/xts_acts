<div class="container">
    <div class="content-title">
        <text class="title">Startup</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>
    <list class="scroll-area">
        <list-item class="litem" style="height:440px;">
            <text class="box-title">设备信息 deviceInfo</text>
            <text class="result">{{ resultText }}</text>
            <text class="status-text">状态: {{ statusMsg }}</text>
            <div class="op-row">
                <input class="opBtn" type="button" value="获取信息" onclick="clickAction" />
            </div>
            <div class="pf-row">
                <input class="pfBtn" style="background-color:{{dPassColor}};" type="button" value="pass" onclick="passD" />
                <input class="pfBtn" style="background-color:{{dFailColor}};" type="button" value="fail" onclick="failD" />
            </div>
        </list-item>
    </list>
    <div class="bottom-bt">
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
