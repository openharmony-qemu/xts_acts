<div class="container">
    <div class="content-title">
        <text class="title">chart</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>
    <list class="scroll-area">
        <list-item class="litem" style="height:335px;">
            <text class="box-title">折线图 chart(line)</text>
            <chart class="chart-area" type="line" ref="linechart" options="{{lineOps}}" datasets="{{lineData}}"></chart>
            <div class="op-row">
                <input class="opBtn" type="button" value="Add data" onclick="addData" />
            </div>
            <div class="pf-row">
                <input class="pfBtn" style="background-color:{{cPassColor}};" type="button" value="pass" onclick="passC" />
                <input class="pfBtn" style="background-color:{{cFailColor}};" type="button" value="fail" onclick="failC" />
            </div>
        </list-item>
    </list>
    <div class="bottom-bt">
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
