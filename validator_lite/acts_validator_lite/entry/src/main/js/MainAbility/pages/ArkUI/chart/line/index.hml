<div class="container">
    <div class="content-title">
        <text style="width:130px;height:50px;text-align: center;font-size:16px;">char-line</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>

    <div class="content">
        <chart class="chart" type="line" ref="linechart" options="{{lineOps}}" datasets="{{lineData}}"></chart>
        <input class="button-add" type="button" value="Add data" onclick="addData"/>
    </div>

    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
