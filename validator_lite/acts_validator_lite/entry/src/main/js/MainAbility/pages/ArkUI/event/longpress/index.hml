<div class="container">
  <div class="content-title">
    <text style="width:150px;height:50px;text-align: center;font-size:16px;">longpress</text>
    <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
  </div>

  <div
    class="commonStyle"
    style="background-color:{{color}}"
    onlongpress="longPressEvent"
  ></div>
  <text style="width:90%;height:40px;">
    x: {{pointX}} , y: {{pointY}}
  </text>
  <text style="width:90%;height:80px;">
    timeStamp: {{timeStamp}}
  </text>

  <div class="bottom-bt">
    <input type="button" value="pass" class="button" onclick="passClicked" />
    <input type="button" value="fail" class="button" onclick="failClicked" />
    <input type="button" value="back" class="button" onclick="backClicked" />
  </div>
</div>
