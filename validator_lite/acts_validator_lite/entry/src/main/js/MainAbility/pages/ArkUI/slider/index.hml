<div class="container">
    <div class="content-title">
        <text style="width:150px;height:50px;text-align:center;font-size:16px;">slider</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>
    <div class="content">
        <slider class="demoSlider" min="0" max="100" value="{{ sliderValue }}" onchange="onSliderChange"></slider>
        <text style="font-size:16px;color:#4caf50;margin:10px;">Value: {{ sliderValue }}</text>
    </div>
    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
