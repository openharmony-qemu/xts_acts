<!-- SVG路径：path 元素的曲线/折线/圆弧命令，参考talm RM.003 basic_path / RM.002 basic_star -->
<div class="container">
  <div class="header">
    <text class="header-title">SVG路径</text>
    <input type="button" value="?" class="help-btn" onclick="helpClicked" />
  </div>

  <list class="content">
    <!-- 000 polyline 折线元素 -->
    <list-item class="card">
      <text class="label">000 polyline折线</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <polyline points="20,80 80,20 140,80 200,20 260,80" fill="none" stroke="#44aa44" stroke-width="3"/>
        </svg>
      </div>
      <text class="expect">预期：绿色锯齿折线，折点位置正确，线条不闭合</text>
    </list-item>

    <!-- 001 贝塞尔曲线：C 三次贝塞尔 + S 平滑接续 -->
    <list-item class="card">
      <text class="label">001 贝塞尔曲线(path C/S)</text>
      <div class="svg-item">
        <svg width="450" height="225" viewBox="0 0 200 150">
          <path d="M10,80 C40,10 65,10 95,80 S150,150 180,80" fill="none" stroke="#ff8800" stroke-width="3"/>
        </svg>
      </div>
      <text class="expect">预期：橙色平滑S形曲线，弯曲处无棱角或断裂</text>
    </list-item>

    <!-- 002 Path折线：L 指令折线 -->
    <list-item class="card">
      <text class="label">002 Path折线(path L)</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <path d="M20,20 L80,80 L140,20 L200,80 L260,20" fill="none" stroke="#aa66cc" stroke-width="3"/>
        </svg>
      </div>
      <text class="expect">预期：紫色折线，折点位置正确，线条连续不闭合、无断裂</text>
    </list-item>

    <!-- 003 弧线路径：A 圆弧指令拼接圆形 -->
    <list-item class="card">
      <text class="label">003 弧线路径(path A)</text>
      <div class="svg-item">
        <svg width="450" height="225" viewBox="0 0 200 150">
          <path d="M120,90 A30,30 0 1,1 180,90 A30,30 0 1,1 120,90" fill="#ff4488"/>
        </svg>
      </div>
      <text class="expect">预期：两段A圆弧指令拼接成完整粉色圆形，圆弧衔接位置无缺口、错位、变形</text>
    </list-item>

    <!-- 004 路径闭合：Z 指令对比闭合与不闭合 -->
    <list-item class="card">
      <text class="label">004 路径闭合(path Z)</text>
      <div class="svg-item">
        <svg width="450" height="240" viewBox="0 0 450 190">
          <path d="M56,50 L68,74 L94,74 L77,90 L85,116 L56,100 L27,116 L35,90 L18,74 L44,74"
                fill="none" stroke="#e53935" stroke-width="2"/>
          <path d="M168,50 L180,74 L206,74 L189,90 L197,116 L168,100 L139,116 L147,90 L130,74 L156,74 Z"
                fill="none" stroke="#4488ff" stroke-width="2"/>
          <path d="M280,50 L292,74 L318,74 L301,90 L309,116 L280,100 L251,116 L259,90 L242,74 L268,74 Z"
                fill="#ffd700"/>
          <path d="M392,50 L404,74 L430,74 L413,90 L421,116 L392,100 L363,116 L371,90 L354,74 L380,74 Z"
                fill="#ffd700" stroke="#ff8c00" stroke-width="2"/>
          <text x="17" y="175" font-size="13" fill="#333333">无Z｜不闭合</text>
          <text x="129" y="175" font-size="13" fill="#333333">带Z｜仅描边</text>
          <text x="241" y="175" font-size="13" fill="#333333">带Z｜仅填充</text>
          <text x="347" y="175" font-size="13" fill="#333333">带Z｜填充+描边</text>
        </svg>
      </div>
      <text class="expect">预期：四颗五角星几何轮廓一致；无Z时红色路径首尾有缺口，带Z时蓝色描边/金色填充/填充+描边均正确闭合</text>
    </list-item>

    <!-- 005 星形路径自相交：验证自相交路径填充规则 -->
    <list-item class="card">
      <text class="label">005 星形路径自相交</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <path d="M150,20 L180,100 L90,50 L210,50 L120,100 Z" fill="#ffaa00" stroke="#e53935" stroke-width="2"/>
        </svg>
      </div>
      <text class="expect">预期：自相交五角星按nonzero规则填充，中心区域不镂空；红色描边完整</text>
    </list-item>

    <!-- 006 五角星少个角：路径缺少一个外角顶点，形成四角星 -->
    <list-item class="card">
      <text class="label">006 五角星少个角</text>
      <div class="svg-item">
        <svg width="450" height="225" viewBox="0 0 200 150">
          <path d="M100,10 L120,60 L175,60 L130,90 L145,140 L100,115 L55,140 L70,90 L25,60 L80,60 Z"
                fill="#ffd700" stroke="#ff8c00" stroke-width="2" opacity="0.3"/>
          <path d="M100,10 L120,60 L175,60 L130,90 L145,140 L100,115 L55,140 L70,90 L80,60 Z"
                fill="#ff4444" stroke="#e53935" stroke-width="2"/>
        </svg>
      </div>
      <text class="expect">预期：五角星路径缺少一个外角顶点，呈四角星形态，填充与描边正常渲染</text>
    </list-item>

    <!-- 底部 pass/fail/back 按钮，作为 list 最后一项，随 list 滚动可见 -->
    <list-item class="bottom-card">
      <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
      </div>
    </list-item>
  </list>
</div>
