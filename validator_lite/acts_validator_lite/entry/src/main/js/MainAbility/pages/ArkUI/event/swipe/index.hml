<div class="container">
  <div class="content-title">
    <text style="width:90px;height:50px;text-align: center;font-size:16px;">swipe</text>
    <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
  </div>

  <div
      class="commonStyle"
      style="background-color:{{color}}"
      onswipe="swipe"
      ></div>
  <text style="width:90%;height:40px;font-size:16px;text-align:center;">
    方向: {{direction}} , 距离: {{distance}}
  </text>
  <text style="width:90%;height:80px;font-size:16px;text-align:center;">
    timeStamp: {{timeStamp}}
  </text>

  <div class="bottom-bt">
    <input type="button" value="pass" class="button" onclick="passClicked" />
    <input type="button" value="fail" class="button" onclick="failClicked" />
    <input type="button" value="back" class="button" onclick="backClicked" />
  </div>
</div>
