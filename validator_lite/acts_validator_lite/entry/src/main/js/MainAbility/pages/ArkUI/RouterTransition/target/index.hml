<div class="container">
    <div class="content-title">
        <text class="title">Router Transition 结果</text>
    </div>
    <div class="card">
        <text class="typeText">{{ type }}</text>
        <text class="infoText">已切换到本页（router.replace 动效类型：{{ type }}）</text>
        <text class="statusText">{{ msg }}</text>
        <div class="pf-row">
            <input class="backBtn" type="button" value="返回列表" onclick="backClicked" />
        </div>
    </div>
    <div class="bottom-bt">
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
