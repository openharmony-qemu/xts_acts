<!-- SVG变换：transform 属性的平移/缩放/旋转/复合变换/g分组，参考talm RM.002 basic_transform -->
<div class="container">
  <div class="header">
    <text class="header-title">SVG变换</text>
    <input type="button" value="?" class="help-btn" onclick="helpClicked" />
  </div>

  <list class="content">
    <!-- 001 transform translate 平移 -->
    <list-item class="card">
      <text class="label">001 平移(translate)</text>
      <div class="svg-item">
        <svg width="450" height="140" viewBox="0 0 400 140" if="{{applied1}}">
          <rect x="40" y="40" width="60" height="60" fill="none" stroke="#aaaaaa" stroke-dasharray="4 3"/>
          <rect x="40" y="40" width="60" height="60" fill="#4488ff" transform="translate(80,20)"/>
        </svg>
        <svg width="450" height="140" viewBox="0 0 400 140" if="{{!applied1}}">
          <rect x="40" y="40" width="60" height="60" fill="none" stroke="#aaaaaa" stroke-dasharray="4 3"/>
          <rect x="40" y="40" width="60" height="60" fill="#4488ff"/>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{applied1 ? '恢复原位' : '执行变换'}}" class="btn" onclick="toggle('applied1')" />
      </div>
      <text class="expect">预期：点击后蓝色方块向右80、向下20偏移；恢复后与虚线参考框完全重合</text>
    </list-item>

    <!-- 002 transform scale 缩放 -->
    <list-item class="card">
      <text class="label">002 缩放(scale)</text>
      <div class="svg-item">
        <svg width="450" height="140" viewBox="0 0 400 140" if="{{applied2}}">
          <rect x="50" y="50" width="50" height="50" fill="#ffaa33" transform="scale(0.6)"/>
        </svg>
        <svg width="450" height="140" viewBox="0 0 400 140" if="{{!applied2}}">
          <rect x="50" y="50" width="50" height="50" fill="#ffaa33"/>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{applied2 ? '恢复原位' : '执行变换'}}" class="btn" onclick="toggle('applied2')" />
      </div>
      <text class="expect">预期：点击后方块缩小，以左上角为变换原点；恢复后回到原始大小</text>
    </list-item>

    <!-- 003 transform rotate 定点旋转 -->
    <list-item class="card">
      <text class="label">003 旋转(rotate)</text>
      <div class="svg-item">
        <svg width="450" height="140" viewBox="0 0 400 140" if="{{applied3}}">
          <circle cx="70" cy="70" r="3" fill="#f00"/>
          <rect x="40" y="40" width="60" height="60" fill="#66bb6a" transform="rotate(30,70,70)"/>
        </svg>
        <svg width="450" height="140" viewBox="0 0 400 140" if="{{!applied3}}">
          <circle cx="70" cy="70" r="3" fill="#f00"/>
          <rect x="40" y="40" width="60" height="60" fill="#66bb6a"/>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{applied3 ? '恢复原位' : '执行变换'}}" class="btn" onclick="toggle('applied3')" />
      </div>
      <text class="expect">预期：点击后方块以红点中心顺时针旋转30°；恢复后恢复水平</text>
    </list-item>

    <!-- 004 transform 复合变换：平移+缩放+旋转 -->
    <list-item class="card">
      <text class="label">004 复合变换(translate+scale+rotate)</text>
      <div class="svg-item">
        <svg width="450" height="160" viewBox="0 0 400 160" if="{{applied4}}">
          <rect x="0" y="0" width="60" height="60" fill="#ee6666" transform="translate(60,40) scale(0.8) rotate(20)"/>
        </svg>
        <svg width="450" height="160" viewBox="0 0 400 160" if="{{!applied4}}">
          <rect x="0" y="0" width="60" height="60" fill="#ee6666"/>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{applied4 ? '恢复原位' : '执行变换'}}" class="btn" onclick="toggle('applied4')" />
      </div>
      <text class="expect">预期：点击后依次执行平移、缩放、旋转矩阵运算，图形姿态正确；恢复后回到原始位置</text>
    </list-item>

    <!-- 005 g分组静态transform，批量变换 -->
    <list-item class="card">
      <text class="label">005 g分组变换</text>
      <div class="svg-item">
        <svg width="450" height="160" viewBox="0 0 400 160" if="{{applied5}}">
          <g transform="translate(60,40) rotate(15)">
            <rect x="0" y="0" width="50" height="50" fill="#4488ff"/>
            <circle cx="65" cy="25" r="20" fill="#ffaa33"/>
          </g>
        </svg>
        <svg width="450" height="160" viewBox="0 0 400 160" if="{{!applied5}}">
          <g>
            <rect x="0" y="0" width="50" height="50" fill="#4488ff"/>
            <circle cx="65" cy="25" r="20" fill="#ffaa33"/>
          </g>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{applied5 ? '恢复原位' : '执行变换'}}" class="btn" onclick="toggle('applied5')" />
      </div>
      <text class="expect">预期：点击后组内矩形、圆形跟随g统一变换；恢复后回到原始位置</text>
    </list-item>

    <!-- 底部 pass/fail/back 按钮，作为 list 最后一项，随 list 滚动可见 -->
    <list-item class="bottom-card">
      <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
      </div>
    </list-item>
  </list>
</div>
