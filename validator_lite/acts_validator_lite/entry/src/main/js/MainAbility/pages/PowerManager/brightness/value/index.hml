<div class="container">
    <div class="content-title">
        <text style="width:150px;height:50px;text-align: center;font-size:16px;">屏幕亮度</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>

    <div class="content">
        <text class="content-info"> 当前亮度值: {{getValue}}</text>
        <text class="content-info"> 调节屏幕亮度 </text>
        <slider
                class="sliderStyle"
                min="0"
                max="255"
                value="{{value}}"
                onclick="clickSlider"
                onchange="valueChange"
                />
        <text class="content-info"> 滑动条当前值：{{value}} </text>
        <text class="content-info">状态: {{statusMsg}}</text>
    </div>

    <div class="bottom-bt">
        <input type="button" value="获取亮度" class="button-operate" onclick="getBrightnessValue" />
    </div>

    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
