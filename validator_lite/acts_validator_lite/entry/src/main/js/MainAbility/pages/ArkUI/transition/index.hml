<div class="container">
    <div class="content-title">
        <text class="title-text">动画</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>
    <div class="divFrame">
        <div class="divBlock divAnimationStyle" style="animation-name:{{animationName}}" onclick="changeAnimation">
        </div>
        <div class="divBlock divAnimationStyle" style="animation-name:{{animationName2}}" onclick="changeAnimation">
        </div>
    </div>
    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
