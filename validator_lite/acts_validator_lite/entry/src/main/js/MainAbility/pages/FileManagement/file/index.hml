<div class="container">
    <div class="content-title">
        <text class="title">file</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>
    <list class="scroll-area">
        <list-item class="litem" style="height:290px;">
            <text class="box-title">文件存储 File</text>
            <text class="tip" show="{{!supported}}">{{ fTip }}</text>
            <text class="result">{{ resultText }}</text>
            <text class="status-text">状态: {{ statusMsg }}</text>
            <div class="op-row">
                <input class="opBtn" type="button" value="测试file" onclick="checkFile" />
            </div>
            <div class="pf-row">
                <input class="pfBtn" style="background-color:{{fPassColor}};" type="button" value="pass" onclick="passF" />
                <input class="pfBtn" style="background-color:{{fFailColor}};" type="button" value="fail" onclick="failF" />
            </div>
        </list-item>
    </list>
    <div class="bottom-bt">
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
