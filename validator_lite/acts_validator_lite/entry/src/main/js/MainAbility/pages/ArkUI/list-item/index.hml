<div class="container">
  <div class="content-title">
    <text style="width:150px;height:50px;text-align: center;font-size:16px;">list-item</text>
    <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
  </div>

  <list
          id="list1"
          class="content-list"
          onclick="listClick"
          onscrollend="scrollEnd"
          >
    <list-item class="list-row" for="{{listData}}">
      <image src="{{$item}}" class="list-img" />
      <text class="list-text">
        item--{{$idx}}
      </text>
    </list-item>
  </list>

  <div class="bottom-bt">
    <input type="button" value="pass" class="button" onclick="passClicked" />
    <input type="button" value="fail" class="button" onclick="failClicked" />
    <input type="button" value="back" class="button" onclick="backClicked" />
  </div>
</div>
