<div class="container">
    <div class="content-title">
        <text style="width:150px;height:50px;text-align: center;font-size:16px;">屏幕亮度</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>

    <div class="content">
        <text class="content-info"> 当前亮度模式: {{modeType}}</text>
        <text class="content-info"> 设置亮度模式 </text>
        <div class="select-mode">
            <input type="button" value="手动调" style="width:40%;height:40px;font-size:16px;" on:click="setBrightnessMode(0)" />
            <input type="button" value="自动调" style="width:40%;height:40px;font-size:16px;" on:click="setBrightnessMode(1)" />
        </div>
        <div class="keep-screen">
            <text style="font-size:16px;width:50%;">屏幕常亮：</text>
            <switch class="keep-screen-switch" checked="{{keepScreen}}" @change="keepScreenChange"></switch>
        </div>
        <text class="content-info">状态: {{statusMsg}}</text>

    </div>

    <div class="bottom-bt">
        <input type="button" value="获取模式" class="button-operate" onclick="getBrightnessMode" />
    </div>

    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
