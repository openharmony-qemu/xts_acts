<div class="container">
    <div class="content-title">
        <text style="width:150px;height:50px;text-align: center;font-size:16px;">timeout</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>

    <div class="content">
        <text class="text">{{value}}</text>
        <text class="text">状态: {{statusMsg}}</text>
    </div>

    <div class="bottom-operate">
        <input type="button" class="button-operate" value="startTimer" onclick="startTimer" />
        <input type="button" class="button-operate" value="clearTimer" onclick="clearTimer" />
    </div>

    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
