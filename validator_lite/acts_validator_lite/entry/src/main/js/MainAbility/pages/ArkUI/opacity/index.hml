<div class="container">
    <div class="content-title">
        <text style="width:150px;height:50px;text-align: center;font-size:16px;">opacity</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>

    <div style="height:80px;" class="divFrame">
        <image src="/common/icon.png" class="imageBlock"></image>
    </div>
    <div style="height:80px; opacity:0.5" class="divFrame">
        <image src="/common/icon.png" class="imageBlock"></image>
    </div>
    <div style="height:80px; opacity:0.5" class="divFrame">
        <image src="/common/icon.png" style="opacity:0.5" class="imageBlock"></image>
    </div>

    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
