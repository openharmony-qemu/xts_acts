<div class="container">
    <div class="content-title">
        <text class="title">storage</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>
    <list class="scroll-area">
        <list-item class="litem" style="height:290px;">
            <text class="box-title">存储 Storage</text>
            <text class="tip" show="{{!supported}}">{{ stTip }}</text>
            <text class="result">{{ resultText }}</text>
            <text class="status-text">状态: {{ statusMsg }}</text>
            <div class="op-row">
                <input class="opBtn" type="button" value="测试storage" onclick="checkStorage" />
            </div>
            <div class="pf-row">
                <input class="pfBtn" style="background-color:{{stPassColor}};" type="button" value="pass" onclick="passSt" />
                <input class="pfBtn" style="background-color:{{stFailColor}};" type="button" value="fail" onclick="failSt" />
            </div>
        </list-item>
    </list>
    <div class="bottom-bt">
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
