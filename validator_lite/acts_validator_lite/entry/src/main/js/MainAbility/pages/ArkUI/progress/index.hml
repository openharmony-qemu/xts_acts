<div class="container">
    <div class="content-title">
        <text style="width:150px;height:50px;text-align:center;font-size:16px;">progress</text>
        <input type="button" value="?" class="backBtnHelp" onclick="helpClicked" />
    </div>
    <div class="content">
        <progress type="horizontal" class="hor-progress" percent="{{horizontalVal}}" onclick="changeHorizontal"></progress>
        <progress type="arc" class="min-progress" percent="{{arcVal}}" onclick="changeArc"></progress>
    </div>
    <div class="bottom-bt">
        <input type="button" value="pass" class="button" onclick="passClicked" />
        <input type="button" value="fail" class="button" onclick="failClicked" />
        <input type="button" value="back" class="button" onclick="backClicked" />
    </div>
</div>
