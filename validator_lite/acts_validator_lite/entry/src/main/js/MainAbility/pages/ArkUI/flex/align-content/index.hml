<div class="container">
    <div class="header">
        <text class="header-title">flex align-content</text>
        <input type="button" value="?" class="help-btn" onclick="helpClicked" />
    </div>

    <list class="content" scrollbar="on">
        <list-item class="card card-default">
            <div class="card-head">
                <text class="label">001 default value and stretch</text>
            </div>
            <div class="case-row">
                <div class="case-block">
                    <text class="case-title">default: no align-content</text>
                    <div class="demo">
                        <div class="stretch-box r"></div>
                        <div class="stretch-box g"></div>
                        <div class="stretch-box b"></div>
                        <div class="stretch-box o"></div>
                        <div class="stretch-box p"></div>
                        <div class="stretch-box t"></div>
                    </div>
                </div>
                <div class="case-block">
                    <text class="case-title">align-content: stretch</text>
                    <div class="demo ac-stretch">
                        <div class="stretch-box r"></div>
                        <div class="stretch-box g"></div>
                        <div class="stretch-box b"></div>
                        <div class="stretch-box o"></div>
                        <div class="stretch-box p"></div>
                        <div class="stretch-box t"></div>
                    </div>
                </div>
            </div>
            <text class="expect">Expected: default and explicit stretch look the same; two wrapped rows stretch to fill cross axis height.</text>
        </list-item>

        <list-item class="card card-values">
            <div class="card-head">
                <text class="label">002 explicit align-content values</text>
            </div>
            <div class="case-row-small">
                <div class="case-block-small">
                    <text class="case-title">flex-start</text>
                    <div class="demo-small ac-start">
                        <div class="box r"></div>
                        <div class="box g"></div>
                        <div class="box b"></div>
                        <div class="box o"></div>
                        <div class="box p"></div>
                        <div class="box t"></div>
                    </div>
                </div>
                <div class="case-block-small">
                    <text class="case-title">center</text>
                    <div class="demo-small ac-center">
                        <div class="box r"></div>
                        <div class="box g"></div>
                        <div class="box b"></div>
                        <div class="box o"></div>
                        <div class="box p"></div>
                        <div class="box t"></div>
                    </div>
                </div>
                <div class="case-block-small">
                    <text class="case-title">flex-end</text>
                    <div class="demo-small ac-end">
                        <div class="box r"></div>
                        <div class="box g"></div>
                        <div class="box b"></div>
                        <div class="box o"></div>
                        <div class="box p"></div>
                        <div class="box t"></div>
                    </div>
                </div>
                <div class="case-block-small">
                    <text class="case-title">space-between</text>
                    <div class="demo-small ac-between">
                        <div class="box r"></div>
                        <div class="box g"></div>
                        <div class="box b"></div>
                        <div class="box o"></div>
                        <div class="box p"></div>
                        <div class="box t"></div>
                    </div>
                </div>
            </div>
            <text class="expect">Expected: rows are packed at start, centered, packed at end, or placed at top and bottom according to align-content.</text>
        </list-item>

        <list-item class="card card-column">
            <div class="card-head">
                <text class="label">003 column wrap stretch line width</text>
            </div>
            <div class="column-demo">
                <div class="column-item column-wide g"></div>
                <div class="column-item k"></div>
                <div class="column-item o"></div>
                <div class="column-item b"></div>
                <div class="column-item p"></div>
                <div class="column-item t"></div>
                <div class="column-item m"></div>
                <div class="column-item column-wide g"></div>
                <div class="column-item b"></div>
                <div class="column-item r"></div>
                <div class="column-item y"></div>
            </div>
            <text class="expect">Expected: column wrap makes 4 columns; columns containing 1 and 8 are wide, columns 4-6 and 0-1 are narrow but stretched from remaining space.</text>
        </list-item>

        <list-item class="bottom-card">
            <div class="bottom-bt">
                <input type="button" value="pass" class="button" onclick="passClicked" />
                <input type="button" value="fail" class="button" onclick="failClicked" />
                <input type="button" value="back" class="button" onclick="backClicked" />
            </div>
        </list-item>
    </list>
</div>
