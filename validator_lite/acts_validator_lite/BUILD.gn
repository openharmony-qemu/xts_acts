import("//build/lite/config/hap_pack.gni")
import("//foundation/arkui/ace_engine_lite/ace_lite.gni")
import("//test/xts/tools/lite/build/xts_gated_js_suite.gni")

# Page-transition capability switch. Declared in
# foundation/arkui/ace_engine_lite/ace_lite.gni (default false) and turned on per
# product through the component "features" in vendor <product>/config.json.
# Importing the engine's own declaration keeps the gate below and the engine
# reading the same source; a case whose capability is compiled out cannot pass, so
# it is dropped from the suite instead of shipping.
import("//foundation/arkui/ace_engine_lite/ace_lite.gni")
_suite_dir =
    "$root_out_dir/suites/acts_validator_lite/testcases/acts_validator_lite"
_tools_dir = "$root_out_dir/suites/acts_validator_lite/testcases/tools"

# Pages that every product builds; pages needing an engine capability are appended
# below, each inside the matching switch.
_pages = [
  "pages/index/index",
  "pages/ArkUI/chart/line/index",
  "pages/ArkUI/common/index/index",
  "pages/ArkUI/marquee/index",
  "pages/ArkUI/ui_advanced/index",
  "pages/ArkUI/ui_basic/index",
  "pages/Communication/nfc/index",
  "pages/DistributedData/storage/index",
  "pages/FileManagement/file/index",
  "pages/PowerManager/power/index",
  "pages/Startup/deviceInfo/index",
  "pages/Sensors/index/index",
  "pages/Location/index/index",
  "pages/common/help/index",
]

# Capability-gated pages. With a switch off the render step drops these routes from
# the generated manifest.json / config.json and removes the pages, their app.js
# report items, the home button, the navigateTo route and the submenu row; a
# dangling reference fails the build instead of silently shipping.

if (ace_engine_lite_feature_page_transition_effect) {
  _pages += [
    "pages/ArkUI/RouterTransition/index/index",
    "pages/ArkUI/RouterTransition/normal/index",
    "pages/ArkUI/RouterTransition/edge_api/index",
    "pages/ArkUI/RouterTransition/edge_duration/index",
    "pages/ArkUI/RouterTransition/target/index",
  ]
}

if (ace_engine_lite_enable_flex_layout_config) {
  _pages += [
    "pages/ArkUI/flex/aspect-ratio/index",
    "pages/ArkUI/flex/item-sizing/index",
    "pages/ArkUI/flex/align-self/index",
    "pages/ArkUI/flex/size-constraints/index",
    "pages/ArkUI/flex/align-content/index",
    "pages/ArkUI/flex/flexDirection/index",
    "pages/ArkUI/flex/justifyContent/index",
    "pages/ArkUI/flex/alignItems/index",
    "pages/ArkUI/flex/flexWrap/index",
    "pages/ArkUI/flex/flex-gap/index",
    "pages/ArkUI/flex/flex-margin-left/index",
    "pages/ArkUI/flex/flex-overflow/index",
    "pages/ArkUI/flex/flex-position/index",
  ]
}

if (ace_engine_lite_enable_gradient_capability) {
  _pages += [
    "pages/ArkUI/gradient_angle/index",
    "pages/ArkUI/gradient_button/index",
    "pages/ArkUI/gradient_direction/index",
    "pages/ArkUI/gradient_list/index",
  ]
}

if (ace_engine_lite_enable_animation_capability) {
  _pages += [
    "pages/ArkUI/pathAnimator/index",
    "pages/ArkUI/transition_basic/index",
  ]
}

if (ace_engine_lite_enable_svg_component_config) {
  _pages += [
    "pages/ArkUI/svgAnimate/index",
    "pages/ArkUI/svgPaint/index",
    "pages/ArkUI/svgPath/index",
    "pages/ArkUI/svgShape/index",
    "pages/ArkUI/svgText/index",
    "pages/ArkUI/svgTransform/index",
  ]
}

if (ace_engine_lite_enable_element_transition_capability) {
  _pages += [
    "pages/ArkUI/element-transition/index",
  ]
}

_extra_js = [
  "common/js/event.js",
  "common/js/general.js",

  # Only imported by the three gated RouterTransition group pages.
  "common/js/router_transition.js",
  "common/js/swiper.js",

  # Image assets referenced by ui_basic (opacity) and ui_advanced (image / image-animator).
  "common/icon.png",
  "common/A094_051.png",
  "common/A094_052.png",
  "common/A094_053.png",
  "common/A094_054.png",
  "common/A094_055.png",
  "common/A094_056.png",
  "common/A094_057.png",
  "common/A094_058.png",
  "common/A094_059.png",
  "common/A094_060.png",
  "common/A094_061.png",
  "common/A094_062.png",
  "common/A094_063.png",
  "common/A094_064.png",
  "common/A094_065.png",
  "common/A094_066.png",
  "common/A094_067.png",
]

xts_gated_js_suite("validator_src") {
  src_root = "entry/src/main/js/MainAbility"
  config_json = "entry/src/main/config.json"
  pages = _pages
  extra_sources = _extra_js
}

action("acts_validator_lite_ace_loader_build") {
  script = "pre_build.py"
  outputs = [ "$target_gen_dir/ace_loader_build.stamp" ]
  args = [ rebase_path("$target_gen_dir/ace_loader_build.stamp") ]
}

action("acts_validator_lite_js_bundle") {
  deps = [
    ":acts_validator_lite_ace_loader_build",
    ":validator_src_render",
  ]
  script = "acts_validator_lite_build_js.py"
  sources = [
    "$root_out_dir/validator_src/config.json",
    "$root_out_dir/validator_src/main/manifest.json",
  ]
  outputs = [
    "$root_out_dir/acts_validator_lite/assets/js/default/app.js",
    "$root_out_dir/acts_validator_lite/assets/js/default/manifest.json",
    "$root_out_dir/acts_validator_lite/assets/js/default/pages/index/index.js",
  ]
  args = [
    rebase_path("$root_out_dir/validator_src/main"),
    rebase_path("$root_out_dir/acts_validator_lite/assets/js/default"),
  ]
}

group("acts_validator_lite_js_assets") {
  deps = [ ":acts_validator_lite_js_bundle" ]
}

hap_pack("acts_validator_lite_hap") {
  deps = [ ":acts_validator_lite_js_assets" ]
  mode = "hap"
  json_path = "$root_out_dir/validator_src/config.json"
  assets_path = "$root_out_dir/acts_validator_lite/assets"
  force = "true"
  cert_profile = "cert/openharmony_sx.p7b"
  resources_path = "entry/src/main/resources"
  hap_name = "ActsValidatorLite"
  privatekey = "HOS Application Provision Release"
}

action("acts_validator_lite_deploy") {
  deps = [ ":acts_validator_lite_hap" ]
  if (ohos_kernel_type == "liteos_a" || ohos_kernel_type == "linux") {
    deps += [
      "//foundation/ability/ability_lite/services/abilitymgr_lite/tools:aa",
      "//foundation/bundlemanager/bundle_framework_lite/services/bundlemgr_lite/tools:bm",
    ]
  }
  script = "//test/xts/tools/lite/build/deploy_lite.py"
  sources = [ "Test.json" ]
  outputs = [
    "$_suite_dir/ActsValidatorLite.hap",
    "$_suite_dir/ActsValidatorLite.json",
    "$_tools_dir/aa",
  ]
  args = [
    "--hap",
    rebase_path("$root_out_dir/system/internal/ActsValidatorLite.hap"),
    "--hap-out",
    rebase_path(_suite_dir),
    "--test-json",
    rebase_path("Test.json"),
    "--test-json-out",
    rebase_path("$_suite_dir/ActsValidatorLite.json"),
    "--aa-src",
    rebase_path("$root_out_dir/dev_tools/bin/aa"),
    "--tools-out",
    rebase_path(_tools_dir),
    "--kernel-type",
    "${ohos_kernel_type}",
  ]
}

action("acts_validator_lite_copy_bm") {
  deps = [ "//foundation/bundlemanager/bundle_framework_lite/services/bundlemgr_lite/tools:bm" ]
  script = "//test/xts/tools/lite/build/utils.py"
  outputs = [ "$_tools_dir/bm" ]
  args = [
    "--method_name",
    "copy_file",
    "--arguments",
    "output=" + rebase_path(_tools_dir) + "#sources=" +
        rebase_path("$root_out_dir/dev_tools/bin/bm") + "#to_dir=True",
  ]
}

action("acts_validator_lite_remove_from_rootfs") {
  deps = [
    ":acts_validator_lite_copy_bm",
    ":acts_validator_lite_deploy",
  ]
  script = "rm_from_rootfs.py"
  outputs = [ "$target_gen_dir/rm_acts_validator_lite.stamp" ]
  args = [
    "--remove",
    rebase_path("$root_out_dir/system/internal/ActsValidatorLite.hap"),
    "--stamp",
    rebase_path("$target_gen_dir/rm_acts_validator_lite.stamp"),
  ]
}
