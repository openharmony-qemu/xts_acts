{
    "description": "Configuration for hjunit demo Tests",
    "driver": {
        "type": "OHJSUnitTest",
        "test-timeout": "180000",
        "shell-timeout": "180000",
        "bundle-name": "ohos.acts.bms.pcselfdistplugin.static",
        "module-name": "entry",
        "testcase-timeout": 240000
    },
    "kits": [{
        "test-file-name": [
            "ActsBmsPCSelfDistPluginStaticTest.hap"
        ],
        "type": "AppInstallKit",
        "cleanup-apps": true
    },{
        "type": "ShellKit",
        "run-command": [
            "power-shell wakeup",
            "power-shell setmode 602",
            "param set const.bms.support_local_plugin true"
        ],
        "teardown-command": [
            "param set const.bms.support_local_plugin false"
        ]
    }]
}