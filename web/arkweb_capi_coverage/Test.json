{
  "description": "Configuration for ArkWeb CAPI Coverage Tests",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "600000",
    "shell-timeout": "600000",
    "bundle-name": "com.open.harmony.arkwebcapicoveragetest",
    "module-name": "entry_test",
    "testcase-timeout": "70000"
  },
  "kits": [
    {
      "test-file-name": [
        "ActsArkWebCapiCoverageCppTest.hap",
        "ActsArkWebCapiCoverageTest.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "ShellKit",
      "run-command": [
        "power-shell wakeup",
        "power-shell setmode 602"
      ]
    }
  ]
}
